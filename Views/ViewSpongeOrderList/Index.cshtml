@model ViewSpongeOrderModel
@{
    Layout = "~/Views/Shared/_SidebarLayout.cshtml";
    ViewData["Title"] = "View Sponge Detail";
    var spongeListId = ViewBag.SpongeListId;
}

@section Styles {
<style>
    .color-swatches { display: inline-block; }
    .color-swatch { width: 16px; height: 16px; border-radius: 50%; display: inline-block; }
    .brand-danger { background-color: #d9534f; }
    .brand-warning { background-color: #f0ad4e; }
    .brand-success { background-color: #5cb85c; }
    .sponge-img { width: 40px; height: 40px; }
    .status-btn { margin-right: 5px; }
</style>
}

<div id="pnlMsg" class="alert alert-success" style="display:none;">
    <span id="lblMainMsg"></span>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><strong>Sponge Order Summary</strong></div>
    <div class="panel-body">
        <table class="table table-bordered">
            <tr>
                <td><strong>Request ID</strong></td>
                <td>@Model.RequestId</td>
                <td><strong>Total Sponges</strong></td>
                <td>@Model.TotalSponges</td>
            </tr>
            <tr>
                <td><strong>Delivery Date</strong></td>
                <td>@Model.DeliveryDate</td>
                <td><strong>Requested Date</strong></td>
                <td>@Model.RequestedDate</td>
            </tr>
            <tr>
                <td><strong>Order From-To Date</strong></td>
                <td>@Model.OrderFromTo</td>
                <td><strong>Remarks</strong></td>
                <td>@Model.Remarks</td>
            </tr>
            <tr>
                <td><strong>Status</strong></td>
                <td>
                    <div class="color-swatches">
                        <div class="color-swatch @(Model.Status == 0 ? "brand-danger" : Model.Status == 1 ? "brand-warning" : "brand-success")"></div>
                    </div>
                    @(Model.Status == 0 ? "Pending" : Model.Status == 1 ? "In Process" : "Processed")
                </td>
                <td colspan="2"></td>
            </tr>
        </table>
    </div>
</div>

<div style="margin-bottom:10px;">
    <button type="button" class="btn btn-danger status-btn" onclick="updateStatus(0)">Pending</button>
    <button type="button" class="btn btn-warning status-btn" onclick="updateStatus(1)">In Process</button>
    <button type="button" class="btn btn-success status-btn" onclick="updateStatus(2)">Processed</button>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th><input type="checkbox" id="chkAll" onclick="toggleAll(this)" /></th>
                    <th>Status</th>
                    <th>Items</th>
                    <th>Type</th>
                    <th>Shape</th>
                    <th>Size</th>
                    <th>Sponge Type</th>
                    <th>Dietary</th>
                    <th>Qty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><input type="checkbox" class="chkOrder" value="@item.Id" /></td>
                        <td>
                            <div class="color-swatches">
                                <div class="color-swatch @(item.Status == 0 ? "brand-danger" : item.Status == 1 ? "brand-warning" : "brand-success")"></div>
                            </div>
                        </td>
                        <td>@item.Title</td>
                        <td>@(item.PrdType == 1 ? "Cake" : "Cupcake")</td>
                        <td>@item.Shape</td>
                        <td>@item.Size</td>
                        <td>
                            @{
                                var spongeImg = GetSpongeImage(item.PrdType, item.Sponge);
                            }
                            <img src="/img/icons/sponge/@spongeImg" class="sponge-img" alt="@item.Sponge" /><br/>@item.Sponge
                        </td>
                        <td>@item.Dietary</td>
                        <td>@item.Qty</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div style="margin-top:10px;">
    <button type="button" class="btn btn-danger status-btn" onclick="updateStatus(0)">Pending</button>
    <button type="button" class="btn btn-warning status-btn" onclick="updateStatus(1)">In Process</button>
    <button type="button" class="btn btn-success status-btn" onclick="updateStatus(2)">Processed</button>
</div>

@functions {
    string GetSpongeImage(int prdType, string sponge)
    {
        var s = (sponge ?? "").ToLower();
        if (prdType == 1)
        {
            if (s.Contains("chocolate")) return "chocolate_cake.png";
            if (s.Contains("rainbow")) return "rainbow.png";
            if (s.Contains("butterscotch")) return "butterscotch.png";
            if (s.Contains("red velvet")) return "redvelvet_cake.png";
            if (s.Contains("lemon drizzle")) return "lemon_drizzled.png";
            return "vanilla_cake.png";
        }
        else
        {
            if (s.Contains("chocolate")) return "chocolate_cupcake.png";
            if (s.Contains("red velvet")) return "redvelvet_cupcake.png";
            return "vanilla_cupcake.png";
        }
    }
}

@section Scripts {
<script>
    function toggleAll(master) {
        document.querySelectorAll('.chkOrder').forEach(c => c.checked = master.checked);
    }

    function updateStatus(status) {
        var ids = [];
        document.querySelectorAll('.chkOrder:checked').forEach(c => ids.push(c.value));
        if (ids.length === 0) { alert('Please select at least one item.'); return; }

        $.post('/viewspongeorderlist/updatestatus', {
            spongelistID: @spongeListId,
            selectedIds: ids.join(','),
            status: status
        }, function(resp) {
            if (resp.success) {
                $('#pnlMsg').show();
                $('#lblMainMsg').text(resp.message);
                setTimeout(function() { location.reload(); }, 1000);
            } else {
                alert(resp.message);
            }
        });
    }
</script>
}
