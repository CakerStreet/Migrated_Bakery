@{
    Layout = null;
    var html = ViewBag.Html as string ?? "";
    var previewMode = ViewBag.PreviewMode as string ?? "";
    var orderId = ViewBag.OrderId as string ?? "11885";
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Email Template Previewer</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7f7f7;
            padding: 20px;
        }
        .div_mailtemplate {
            box-shadow: 0 0 10px #ccc;
            display: table;
            margin: 20px auto;
            width: 100%;
            max-width: 700px;
            padding: 20px;
            background-color: #fff;
            border-radius: 6px;
        } 
        .divbuttonouter {
            display: table;
            margin: 20px auto;
            width: auto;
            background-color: #fff;
            padding: 15px;
            border-radius: 6px;
            box-shadow: 0 0 5px #ccc;
            text-align: center;
        }
        .divbuttonouter input[type="button"], .divbuttonouter button {
            margin: 5px;
            padding: 6px 12px;
            background-color: #db3736;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .divbuttonouter input[type="button"]:hover, .divbuttonouter button:hover {
            background-color: #c12e2d;
        }
        .divbuttonouter input[type="text"] {
            padding: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: 100px;
        }
    </style>
</head>
<body>
    <form action="/mailcheck" method="get">
        <div class="divbuttonouter">
            <button type="submit" name="previewMode" value="subscribe">Subscribe</button>
            <button type="submit" name="previewMode" value="forgot">Forgot Pwd</button>
            <button type="submit" name="previewMode" value="register">New Register</button>
            <button type="submit" name="previewMode" value="forgot_bakery">Forgot Pwd (Business)</button>
            <button type="submit" name="previewMode" value="register_business">New Register (Business)</button>
            <button type="submit" name="previewMode" value="contactus">Contact Enquiry</button>
            
            <input type="text" name="orderId" value="@orderId" />
            <button type="submit" name="previewMode" value="ordersuccess">Order Success</button>
            <button type="submit" name="previewMode" value="orderpayout">Order Paid Out</button>
            <button type="submit" name="previewMode" value="cancelled">Order Cancelled</button>
            <button type="submit" name="previewMode" value="trustpilot">Delivery Note - Trust Pilot</button>
            <button type="submit" name="previewMode" value="coupon">Send Coupon</button>
            <button type="submit" name="previewMode" value="emailforwarder">Email Forwarder</button>
        </div>
        
        @if (!string.IsNullOrEmpty(html))
        {
            <div id="div_mailtemplate" class="div_mailtemplate">
                @Html.Raw(html)
            </div>
        }
    </form>
</body>
</html>
