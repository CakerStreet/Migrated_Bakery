@model UpdateOrderImageViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "CRM Update Order Image";
}

@section head {
    <style type="text/css">
        #dropzoneForm { width: 50%; margin: 0 auto; }
        .div_typewisefilter { display: table; z-index: 3; font-size: 12px; }
        .div_typewisefilter.notop { top: 0; }
        .div_typewisefilter .liupdateglobaldisplayorder > a { background-color: #ccc; float: left; margin-left: 5px; opacity: 1; padding: 5px; }
        .liupdateglobaldisplayorder a img { max-width: 18px; }
        .div_typewisefilter li { display: table; opacity: 0.9; margin: 5px; width: 50px; }
        .div_typewisefilter li.liheight { height: 20px; }
        .div_typewisefilter li.liheight select { left: 5px; position: absolute; top: 5px; }
        .div_typewisefilter a { background-color: #fff; display: inline; font-size: 12px; opacity: 0.5; }
        .div_typewisefilter a > img { max-width: 22px; max-height: 22px; }
        .div_typewisefilter a:hover, .div_typewisefilter a.stt { opacity: 1; }
        .div_typewisefilter a.stt { border-color: Green; }
        .table { border: 1px solid #ccc; margin: 0px 0 0 0; }
        .Toppertabl img { padding: 0 5px 7px; }
        .table.Toppertabl { margin: 0 0 20px 0; }
        .table.Toppertabl > thead { background-color: #fff; }
        .btn-default { background-color: #eee; }
        .table tbody tr { background-color: #eee; }
        .table > tbody > tr > td { border-top-width: 0; }
        .div_deliverydetail { margin-bottom: 10px; background-color: #aaa; color: #fff; line-height: 34px; padding-top: 7px; padding-bottom: 7px; }
        .div_backtotop { right: auto; }
        .div_productfile { margin-bottom: 10px; }
        .div_Documents { display: table; width: 100%; }
        .divfiles { display: table; width: 100%; }
        .divfiles li { float: left; line-height: 17px; margin: 5px; min-height: 34px; }
        .divfiles li.imgli { border: 1px solid #ccc; border-radius: 5px; height: 34px; margin: 5px 5px 5px 0; position: relative; width: 34px; padding: 0; overflow: auto; }
        .divfiles li.imgli > img { max-height: 100%; max-width: 100%; padding: 1px; position: static; }
        .divfiles li.lititle { border-width: 0; padding: 0; }
        .caln { text-align: center; }
    </style>
    <script type="text/javascript">
        function UploadPicture(pid, pname) {
            $("#prdTitle").text(pname);
            $("#hdPrdID").val(pid);
            $("#hdApiType").val("0");
            $("#dvPicModal").modal('show');
        }
    </script>
}

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin" id="divspecification">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-1">
                    <a data-toggle="collapse" href="#collapse3" aria-expanded="true"><span class="glyphicon glyphicon-minus"></span></a>
                </div>
                <div class="col-md-11">
                    <h2>@Model.BusinessName</h2>
                </div>
            </div>
            <div class="col-md-12 panel-collapse collapse in" id="collapse3" aria-expanded="true">
                <input type="hidden" id="hfOrderID" value="@Model.OrderId" />
                <input type="hidden" id="hfProductId" value="@Model.ProductId" />
                <div class="form row-fluid">
                    <div class="form-group col-md-12 caln">
                        <a target="_blank">
                            <img src="@Model.ProductImageUrl" style="max-width: 150px; max-height: 150px;" /></a>
                        <br />
                        <strong>@Model.ProductName</strong>
                    </div>
                    <div class="form-group col-md-12 caln div_typewisefilter">
                        <a href="/updateorderimage/download?arg=@System.Net.WebUtility.UrlEncode(Model.DownloadArgument)">
                            <img src="/img/download-icon.png" /></a>
                        <a onclick="UploadPicture(@Model.OrderId, '@Html.Raw(Model.ProductName.Replace("'", "\\'"))');">
                            <img src="/img/upload-icon.png" /></a>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="dvPicModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="prdTitle"></h4>
            </div>
            <div class="modal-body" style="width: 100%">
                <div role="form" class="form-horizontal box-body">
                    <div class="form-group">
                        <div class="col-sm-12">
                            <div class="dropzone" id="dropzoneForm">
                                <div class="fallback">
                                    <input name="file" type="file" />
                                    <input type="submit" value="Upload" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-4">
                            <input id="btnUpload" class="btn btn-danger btn-block btn-flat btn-sign-in" onclick="UploadFiles();"
                                   type="button" value="Upload" />
                            <input id="hdPrdID" type="hidden" />
                            <input id="hdApiType" type="hidden" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
