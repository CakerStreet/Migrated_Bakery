@model CakerStreet.Business.Services.OrderDetailResult
@{
    Layout = null;
    var cdnBase = ViewBag.CdnBase as string ?? "https://cakerstreet1.s3.amazonaws.com/";
    var deliveryModeText = Model.DeliveryMode switch
    {
        0 => "Collection",
        1 => "Hand Delivery",
        2 => "Postal Delivery",
        _ => "Delivery"
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Order Detail</title>
    <style type="text/css" media="all">
        body, body * {
            font-family: Arial, sans-serif;
            font-weight: normal;
            background-color: #ffffff;
        }
        .btn-primary {
            background-color: #b51a1a;
            color: #ffffff;
            border-color: #b51a1a;
            border: 1px solid #b51a1a;
            padding: 8px 20px;
            font-size: 14px;
            cursor: pointer;
            border-radius: 3px;
        }
        .btn-primary:hover {
            background-color: #8e1414;
        }
        b, strong { font-weight: bold; }
        a:link:after, a:visited:after { content: ""; }
        .divmain {
            width: 668px;
            margin: 0 auto;
            padding: 10px;
        }
        .receipt-header {
            text-align: center;
            margin-bottom: 15px;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
        }
        .receipt-header h2 {
            margin: 0 0 5px 0;
            font-size: 20px;
        }
        .receipt-header .order-id {
            font-size: 14px;
            color: #555;
        }
        .section {
            margin-bottom: 15px;
            border: 1px solid #ccc;
            padding: 10px;
            border-radius: 3px;
        }
        .section h4 {
            margin: 0 0 8px 0;
            font-size: 13px;
            font-weight: bold;
            border-bottom: 1px solid #eee;
            padding-bottom: 4px;
        }
        .section p {
            margin: 3px 0;
            font-size: 12px;
            line-height: 1.5;
        }
        .product-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 12px;
        }
        .product-table th {
            background-color: #f5f5f5;
            border: 1px solid #ccc;
            padding: 6px 8px;
            text-align: left;
            font-weight: bold;
        }
        .product-table td {
            border: 1px solid #ccc;
            padding: 6px 8px;
            vertical-align: top;
        }
        .totals-section {
            text-align: right;
            margin-bottom: 15px;
            font-size: 13px;
        }
        .totals-section table {
            margin-left: auto;
            border-collapse: collapse;
        }
        .totals-section td {
            padding: 3px 10px;
        }
        .totals-section .total-row {
            font-weight: bold;
            font-size: 14px;
            border-top: 1px solid #333;
        }
    </style>
    <style type="text/css" media="print">
        @@media page {
            size: A4 landscape;
        }
        @@page {
            margin: 5mm;
            padding: 0;
            size: A4 landscape;
        }
        #dvPrintButtons {
            visibility: hidden;
            display: none;
        }
    </style>
</head>
<body>
    <div class="divmain">
        <div id="dvPrintButtons" style="margin-top: 10px; text-align: center;">
            <button class="btn-primary" onclick="window.print();">Print</button>
        </div>

        <div class="receipt-header">
            <h2>Delivery Receipt</h2>
            <div class="order-id">Order #@Model.OrderId</div>
            <div style="font-size: 12px; color: #555;">
                Date: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="section">
            <h4>Bakery</h4>
            <p><b>@Model.BakeryName</b></p>
            @if (!string.IsNullOrEmpty(Model.BakeryAddress))
            {
                <p>@Model.BakeryAddress</p>
            }
            @if (!string.IsNullOrEmpty(Model.BakeryCity))
            {
                <p>@Model.BakeryCity @Model.BakeryState</p>
            }
            @if (!string.IsNullOrEmpty(Model.BakeryPostcode))
            {
                <p>@Model.BakeryPostcode</p>
            }
            @if (!string.IsNullOrEmpty(Model.BakeryBusinessPhone))
            {
                <p>Phone: @Model.BakeryBusinessPhone</p>
            }
        </div>

        <div class="section">
            <h4>Deliver To</h4>
            <p><b>@Model.ShippingFullName</b></p>
            @if (!string.IsNullOrEmpty(Model.ShippingAddress))
            {
                <p>@Model.ShippingAddress</p>
            }
            @if (!string.IsNullOrEmpty(Model.ShippingCity))
            {
                <p>@Model.ShippingCity@(!string.IsNullOrEmpty(Model.ShippingCounty) ? ", " + Model.ShippingCounty : "")</p>
            }
            <p>@Model.ShippingZip@(!string.IsNullOrEmpty(Model.ShippingCountry) ? ", " + Model.ShippingCountry : "")</p>
            @if (!string.IsNullOrEmpty(Model.ShippingPhone))
            {
                <p>Phone: @Model.ShippingPhone</p>
            }
        </div>

        <div class="section">
            <h4>Delivery Details</h4>
            <p><b>Mode:</b> @deliveryModeText</p>
            <p><b>Date & Time:</b> @Model.CollectionDate.ToString("dd/MM/yyyy") (@Model.CollectionDate.ToString("hh:mm tt") - @Model.CollectionDate.AddHours(1).ToString("hh:mm tt"))</p>
            @if (!string.IsNullOrEmpty(Model.Occasion))
            {
                <p><b>Occasion:</b> @Model.Occasion</p>
            }
        </div>

        <table class="product-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th style="width:50px;">Qty</th>
                    <th style="width:80px;">Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.LineItems)
                {
                    var displayPrice = item.GetDisplayTotalPrice(Model.SaleType, Model.CSMargin, Model.ShopMargin);
                    <tr>
                        <td><b>@item.ProductName</b></td>
                        <td>@item.Quantity</td>
                        <td>£@displayPrice.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="totals-section">
            <table>
                @{
                    var subtotal = Model.LineItems.Sum(i => i.GetDisplayTotalPrice(Model.SaleType, Model.CSMargin, Model.ShopMargin));
                }
                <tr>
                    <td>Subtotal:</td>
                    <td>£@subtotal.ToString("N2")</td>
                </tr>
                @if (Model.ShippingCost > 0)
                {
                    <tr>
                        <td>Delivery:</td>
                        <td>£@Model.ShippingCost.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>Total:</td>
                    <td>£@((subtotal + Model.ShippingCost).ToString("N2"))</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <h4>Customer</h4>
            <p><b>@Model.CustomerName</b></p>
        </div>

        @if (!string.IsNullOrEmpty(Model.CollectionRemarks))
        {
            <div class="section">
                <h4>Remarks</h4>
                <p>@Model.CollectionRemarks</p>
            </div>
        }
    </div>

    <script type="text/javascript">
        window.print();
    </script>
</body>
</html>
