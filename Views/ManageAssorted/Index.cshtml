@using CakerStreet.Business.Controllers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var product = ViewBag.Product as ManageAssortedController.ProductDetailModel;
    var sizeTitle = ViewBag.SizeTitle as string ?? "";
    var items = ViewBag.Items as List<ManageAssortedController.AssortedItem> ?? new();
    var successMsg = ViewBag.SuccessMsg as string;
    var errorMsg = ViewBag.ErrorMsg as string;
    var cdnBase = ViewBag.CdnBase as string ?? "";
    var overallQty = items.Count > 0 ? items[0].Qty : 1;
}

@section head {
    <link href="/css/sellcss.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" rel="stylesheet" />
    <style type="text/css">
        .font-weight-normal
        {
            font-weight: normal;
        }
        .img img
        {
            max-height: 60px;
            max-width: 60px;
        }
        .table.prdlstouter
        {
            margin-top: 20px;
        }
        .ui-menu img
        {
            width: 40px;
            height: 40px;
        }
        .ui-menu li span
        {
            font-size: 1em;
            padding: 0 0 10px 10px;
            margin: 0 0 10px 0 !important;
            white-space: nowrap;
        }
    </style>
}

<input type="hidden" id="hfProductID" value="@product.Id" />

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin" id="divspecification">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-1">
                    <a data-toggle="collapse" href="#collapse3" aria-expanded="true"><span class="glyphicon glyphicon-minus"></span></a>
                </div>
                <div class="col-md-11">
                    <h2>
                        Manage Assorted @product.Name (@product.Code)
                        <a style="float: right; color: #fff; font-size: 14px;" target="_blank" href="/mywebstore?saletype=2&prdtype=3">Manage Assorted inventory</a>
                    </h2>
                </div>
            </div>
            
            <div class="col-md-12 panel-collapse collapse in" id="collapse3" aria-expanded="true">
                <div class="col-md-12 caln" style="margin-top: 15px;">
                    <a href="http://localhost:5000/productdetail/@product.SeoUrl/@product.Id" target="_blank">
                        @if (!string.IsNullOrEmpty(product.Image1))
                        {
                            <img src="https://cakerstreet1.s3.amazonaws.com/Product_images/resized_300_300/@product.Image1" style="max-width: 150px; max-height: 150px;" />
                        }
                        else
                        {
                            <img src="https://cakerstreet1.s3.amazonaws.com/images/blankImages/110x135.jpg" style="max-width: 150px; max-height: 150px;" />
                        }
                    </a>
                </div>
                <div class="clearfix"></div>
                
                <div class="col-md-12 top-margin">
                    @if (!string.IsNullOrEmpty(sizeTitle))
                    {
                        <div class="col-md-12">
                            <p>Size: @sizeTitle</p>
                        </div>
                    }
                    
                    <div class="col-md-1 raln">
                        <label>Quantity:</label>
                    </div>
                    <div class="col-md-2 raln">
                        <input type="number" id="txtQty" class="form-control input-sm txtqty" value="@overallQty" min="1" />
                        <input type="hidden" id="hfQty" value="@overallQty" />
                    </div>
                    <div class="col-md-4">
                        <a id="ancSaveQty" class="btn btn-danger btm-sm">Save Changes</a>
                    </div>
                    
                    <br class="clearfix" />
                    
                    <div id="dvSearchPrd" style="@(items.Count == 0 ? "display:none;" : "")">
                        <form action="/manageassorted/@product.Id/save-topper" method="post">
                            <div class="col-md-6 raln" style="margin-top: 15px;">
                                <input type="text" id="txtSearchTopper" class="form-control input-sm" placeholder="Search Assorted" required="required" />
                                <input type="hidden" name="hfTopperID" id="hfTopperID" />
                                <input type="hidden" name="txtQty" value="@overallQty" id="hdnTopperQty" />
                            </div>
                            <div class="col-md-4" style="margin-top: 15px;">
                                <button type="submit" class="btn btn-danger btn-sm">Save Topper</button>
                            </div>
                        </form>
                    </div>
                </div>
                
                <div class="clearfix"></div>
                
                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div class="alert alert-success" style="margin: 10px;">@successMsg</div>
                }
                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-danger" style="margin: 10px;">@errorMsg</div>
                }
                
                <div class="clearfix"></div>
                
                @if (items.Count > 0)
                {
                    <div class="table prdlstouter" id="our_products">
                        <table class="table table-bordred table-striped">
                            <thead>
                                <tr>
                                    <th>&nbsp;</th>
                                    <th>Title</th>
                                    <th>Display Order</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    <tr class="rowtext">
                                        <td class="img">
                                            <a target="_blank" href="http://localhost:5000/productdetail/@item.ProductSeoUrl/@item.RefProductId">
                                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                                {
                                                    <img src="https://cakerstreet1.s3.amazonaws.com/Product_images/resized_80_80/@item.ProductImage" style="max-height: 60px; max-width: 60px;" />
                                                }
                                                else
                                                {
                                                    <img src="https://cakerstreet1.s3.amazonaws.com/images/blankImages/img75.jpg" style="max-height: 60px; max-width: 60px;" />
                                                }
                                            </a>
                                        </td>
                                        <td class="name">@item.ProductName</td>
                                        <td class="name">
                                            <input id="txtQty_@item.RefProductId" class="form-control input-sm txtqty" style="max-width: 50px; display: inline-block;" value="@item.DisplayOrder" type="number" min="1" />
                                            <a href="javascript:void(0)" onclick="updateDisplayOrder(@item.RefProductId)" class="updateqty">
                                                <span class="glyphicon glyphicon-refresh" aria-hidden="true"></span>
                                            </a>
                                        </td>
                                        <td class="action">
                                            <form action="/manageassorted/@product.Id/delete" method="post" onsubmit="return confirm('Are you sure to delete this item?')" style="display:inline;">
                                                <input type="hidden" name="refProductId" value="@item.RefProductId" />
                                                <button type="submit" class="btn btn-danger btn-red btn-sm btn-savelist">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger" style="margin: 15px;">No Cake Assorted Found. Please set quantity and add topper cakes.</div>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
<script type="text/javascript">
    $(function () {
        $('#txtSearchTopper').autocomplete({
            minLength: 1,
            select: function (event, ui) {
                event.preventDefault();
                $("#txtSearchTopper").val(ui.item.label);
                $("#hfTopperID").val(ui.item.value);
                return false;
            },
            open: function () {
                $(".ui-autocomplete").css("z-index", 1000);
            },
            source: function (request, response) {
                $.ajax({
                    url: "/manageassorted/@product.Id/GetTopperList",
                    type: "POST",
                    dataType: "json",
                    data: JSON.stringify({ keyword: request.term }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        response($.map(data.d, function (item) {
                            return {
                                label: item.product_name,
                                value: item.product_id,
                                img: item.product_image1 ? "https://cakerstreet1.s3.amazonaws.com/Product_images/resized_80_80/" + item.product_image1 : ""
                            };
                        }))
                    },
                    error: function (xhr, status, error) {
                        console.error("Autocomplete error:", error);
                    }
                });
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            var imgHtml = item.img ? "<img src='" + item.img + "'>" : "";
            return $("<li><div>" + imgHtml + "<span>" + item.label + "</span></div></li>").appendTo(ul);
        };

        $("#ancSaveQty").click(function () {
            var qty = parseInt($("#txtQty").val());
            if (isNaN(qty) || qty < 1) {
                alert("Please enter a valid quantity greater than 0.");
                return;
            }
            $.ajax({
                type: "POST",
                url: "/manageassorted/@product.Id/update-qty",
                data: { qty: qty },
                success: function (res) {
                    if (res == 1) {
                        alert("Quantity has been updated successfully.");
                        $("#hfQty").val(qty);
                        $("#hdnTopperQty").val(qty);
                        $("#dvSearchPrd").show();
                    } else {
                        alert("Failed to update quantity.");
                    }
                }
            });
        });
    });

    function updateDisplayOrder(refId) {
        var order = parseInt($("#txtQty_" + refId).val());
        if (isNaN(order) || order < 1) {
            alert("Please enter a valid display order.");
            return;
        }
        $.ajax({
            type: "POST",
            url: "/manageassorted/@product.Id/update-display-order",
            data: { refProductId: refId, displayOrder: order },
            success: function (res) {
                if (res == 1) {
                    alert("Display Order updated successfully.");
                } else {
                    alert("Failed to update display order.");
                }
            }
        });
    }
</script>
