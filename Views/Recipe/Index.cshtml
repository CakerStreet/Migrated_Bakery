        }

        function loadRecipeDetails(id) {
            var $row = $('#details_row_' + id);
            var $container = $row.find('.details-container');
            $container.html('Loading details...');

            $.ajax({
                type: 'POST',
                url: '/managereceipe/ShowReceipeByID',
                data: { id: id },
                success: function (r) {
                    $container.html(r.d);
                },
                error: function (x) {
                    $container.html('Failed to load recipe details. ' + x.responseText);
                }
            });
        }

