        function addDirectionRow(recipeId, anchor) {
            var $container = $(anchor).closest('.divIngredient').find('.divIngredientlistOuter');
            $container.append(
                "<ul data-id='0'>" +
                "<li><textarea class='txtDirection fuzzy form-control' placeholder='Direction' autocomplete='off'></textarea></li>" +
                "<li class='liclose'><a class='pull-left btn btn-xs btn-danger' onclick='removeIngredient(this, 2);'>X</a></li>" +
                "</ul>"
