            // Loader overlay stub matching legacy
        }

        function toggleRecipeDetails(id) {
            var $row = $('#details_row_' + id);
            var $container = $row.find('.details-container');

            if ($row.is(':visible')) {
                $row.hide();
            } else {
                $row.show();
