                "<li class='ligrp1 ins'><input class='txtIngredient form-control' placeholder='Instructions' /></li>" +
                "<li class='ligrp2 ing'><input class='txtIngredientgrp form-control' placeholder='Ingredients' /></li>" +
                "<li class='ligrp cuttype'><input class='txtIngredientcuttype form-control' placeholder='Cut-Type' /></li>" +
                "<li class='ligrp2 ing'>" +
                "<div class='input-group' style='max-width:100px;'><input class='txtIngredientmlperserving form-control' value='0' /><span class='input-group-addon'>ml.</span></div>" +
                "<select class='drpIngredienUnit form-control'>" + measuringHtml + "</select>" +
