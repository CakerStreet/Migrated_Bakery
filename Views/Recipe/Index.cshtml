        function addNutritionRow(anchor) {
            var $container = $(anchor).closest('.divIngredient').find('.divIngredientlistOuter');
            $container.append(
                "<ul data-id='0'>" +
                "<li><input class='txtNutrition form-control' placeholder='Nutrition' /></li>" +
                "<li class='liclose'><a class='pull-left btn btn-xs btn-danger' onclick='removeIngredient(this, 3);'>X</a></li>" +
                "</ul>"
            );
        }

        function updatereceipeByID(anchor, id) {
            var $editOuter = $(anchor).closest('.divreceipe_Editouter');
            
            var payload = {
                title: $editOuter.find('input.txtReceipeTitle').val(),
                servingDet: $editOuter.find('input.txtServing').val(),
                lstingredients: [],
                direction: [],
                nutrition_Information: []
            };

            // Parse ingredients rows
            $editOuter.find('#dvInstruction ul').each(function () {
                var $ul = $(this);
                var ing = {
                    id: parseInt($ul.attr('data-id')),
                    ingredient: $ul.find('input.txtIngredient').val(),
                    ingredientGRP: $ul.find('input.txtIngredientgrp').val(),
                    ingredientcuttype: $ul.find('input.txtIngredientcuttype').val(),
                    ingredientmlperserving: $ul.find('input.txtIngredientmlperserving').val(),
                    ingredientunit: $ul.find('select.drpIngredienUnit').val(),
                    ingredientGRPID: 0
                };

                var grpSelect = $ul.find('select.drpIngredienGRP');
                if (grpSelect.length > 0 && grpSelect.val()) {
                    ing.ingredientGRPID = parseInt(grpSelect.val().split(',')[0]);
                }
                payload.lstingredients.push(ing);
            });

            // Parse directions
            $editOuter.find('#dvDirection textarea.txtDirection').each(function () {
                payload.direction.push($(this).val());
            });

            // Parse nutritions
            $editOuter.find('#dvNutrition input.txtNutrition').each(function () {
                payload.nutrition_Information.push($(this).val());
            });

            $.ajax({
                type: 'POST',
                url: '/managereceipe/updatereceipeByID?id=' + id,
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (r) {
                    if (r.d === "1") {
                        // Refresh to read only
                        ShowReceipeByID(id, 1);
                    } else {
                        alert('Failed to save recipe updates.');
                    }
                },
                error: function (x) {
                    alert('Error saving recipe updates: ' + x.responseText);
                }
            });

            RemoveFuzzy();
        }

        // ─── Horsey Fuzzy Tags Auto-complete Helper ─────────────────────────────────

        function RemoveFuzzy() {
            var lstfuzzy = document.querySelectorAll('.fuzzy');
            for (var i = 0, element; element = lstfuzzy[i]; i++) {
                if (typeof horsey !== 'undefined') {
                    horsey(element).destroy();
                }
            }
        }

        function BindFuzzy(varlist) {
            'use strict';
            if (typeof horsey === 'undefined') return;

            var lstfuzzy = document.querySelectorAll('.fuzzy');
            for (var i = 0, element; element = lstfuzzy[i]; i++) {
                horsey(element, {
                    source: [{ list: varlist }],
                    getText: 'text',
                    getValue: 'value',
                    anchor: '#',
                    blankSearch: 'false',
                    limit: 10
                });
            }
        }

        // ─── Row Commands ──────────────────────────────────────────────────────────

        function saveInlineRow(id) {
            var $row = $('#row_' + id);
            var title = $row.find('input[name="bulkTitles"]').val();
            var price = $row.find('input[name="bulkPrices"]').val();

            if (!title) {
                alert('Title is required!');
                return;
            }

            var form = document.createElement('form');
            form.method = 'post';
            form.action = '/managereceipe/savenormitem';
            
            // Append parameters
            form.appendChild(createHiddenField('id', id));
            form.appendChild(createHiddenField('title', title));
            form.appendChild(createHiddenField('price', price));
            
            document.body.appendChild(form);
            form.submit();
        }

        function cloneRecipeRow(id) {
            if (!confirm('Are you sure you want to clone this recipe to product list?')) return;

            var form = document.createElement('form');
            form.method = 'post';
            form.action = '/managereceipe/clone';
            form.appendChild(createHiddenField('id', id));

            document.body.appendChild(form);
            form.submit();
        }

        function createHiddenField(name, value) {
            var hid = document.createElement('input');
            hid.type = 'hidden';
            hid.name = name;
            hid.value = value;
            return hid;
        }

        // ─── Category Mapping Modal ────────────────────────────────────────────────

        function assignThemesToMultiplePrds(typeId) {
            var selectedCount = $('.rowtext .chk input[type="checkbox"]:checked').length;
            if (selectedCount === 0) {
                alert('please select any item');
                return;
            }

            $('body').addClass('modal-open');
            $('#Mymodal_theme').show().addClass('in').removeClass('hide');
            $('#modalbg_category').show().addClass('in').removeClass('hide');

            $('.chkStoreCategory_outer input:checkbox').prop('checked', false);

            if (typeId == 1) {
                $('.chktag_outer').hide();
                $('.chktheme_outer').show();
                $('.spnClsName').html('Categories');
            } else {
                $('.chktag_outer').show();
                $('.chktheme_outer').hide();
                $('.spnClsName').html('Tags');
            }

            $('#hdnAssignCat').val(typeId);
        }

        function hideModalTheme() {
            $('body').removeClass('modal-open');
            $('#Mymodal_theme').hide().removeClass('in').addClass('hide');
            $('#modalbg_category').hide().removeClass('in').addClass('hide');
        }

        function assignCatToRecipeSubmit() {
            var typeId = $('#hdnAssignCat').val();
            var payload = {
                lnkPrdStoreCat: [],
                cattypeID: parseInt(typeId)
            };

            var checkedCats = [];
            var selector = typeId == "1" ? '.chktheme_outer input:checkbox:checked' : '.chktag_outer input:checkbox:checked';
            $(selector).each(function () {
                checkedCats.push(parseInt($(this).val()));
            });

            if (checkedCats.length === 0) {
                alert('please select any mapping item!');
                return;
            }

            $('.rowtext .chk input[type="checkbox"]:checked').each(function () {
                var recipeId = parseInt($(this).val());
                $.each(checkedCats, function (i, catId) {
                    payload.lnkPrdStoreCat.push({
                        LnkPrdStoreCat_ID: 0,
                        LnkPrdStoreCat_PrdId: recipeId,
                        LnkPrdStoreCat_CatId: catId
                    });
                });
            });

            $.ajax({
                type: 'POST',
                url: '/managereceipe/assignCattoReceipe',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (r) {
                    if (r.d && r.d.data_ID === 1) {
                        hideModalTheme();
                        alert('Record(s) assigned successfully');
                        location.reload();
                    } else {
                        alert('Failed to assign category mappings.');
                    }
                },
                error: function (x) {
                    alert('Error assigning category: ' + x.responseText);
                }
            });
        }

        function removeCatLinkingFromRecipe(catId, recipeId, anchor) {
            $(anchor).closest('.itemli').remove();
            
            $.ajax({
                type: 'POST',
                url: '/managereceipe/UnAssignCattoReceipe',
                contentType: 'application/json',
                data: JSON.stringify({ receipeID: recipeId, catID: catId }),
                success: function (r) {
                    // Mappings removed successfully
                }
            });
        }

        // ─── Bulk Action Handles ───────────────────────────────────────────────────

        function submitBulkAction(actionType) {
            var selectedCount = $('.rowtext .chk input[type="checkbox"]:checked').length;
            if (selectedCount === 0) {
                alert('please select any item!');
                return;
            }

            if (actionType === 'delete') {
                if (!confirm('Are you sure you want to remove selected ' + selectedCount + ' item(s)?')) return;
            }

            $('#hidBulkAction').val(actionType);
            $('#frmBulkAction').submit();
        }

        // ─── Print Actions ─────────────────────────────────────────────────────────

        function printSelectedRecipes() {
            var selectedIds = [];
            $('.rowtext .chk input[type="checkbox"]:checked').each(function () {
                selectedIds.push($(this).val());
            });

            if (selectedIds.length === 0) {
                alert('please select any item!');
                return;
            }

            var url = '/ManageReceipe_Print.aspx?strIDs=' + selectedIds.join(',');
            window.open(url, '_blank');
        }

        function printAllRecipes() {
            var url = '/ManageReceipe_Print.aspx';
            // Append current filter query string
            var filterString = buildFilterUrl(1).split('?')[1] || '';
            if (filterString) {
                url += '?' + filterString;
            }
            window.open(url, '_blank');
        }

        // ─── File Upload Generic Handler ───────────────────────────────────────────

        function ajaxFileUploadRecipe(inputElement, recipeId) {
            var file = inputElement.files[0];
            if (!file) return;

            var formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '/receipegh.ashx?folder_id=receipeImages&foldersize=300_300,80_80&id=' + recipeId,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (r) {
                    // Success callback triggers page refresh to display new image
                    location.reload();
                },
                error: function (x) {
                    alert('Error uploading file: ' + x.responseText);
                }
            });
        }
    </script>
}

@functions {
    public string GetPagingUrl(int pNo)
    {
        var url = $"/managereceipe/page-{pNo}";
        var queryParams = new List<string>();

        if (!string.IsNullOrEmpty(ViewBag.SearchKeyword))
            queryParams.Add($"search={ViewBag.SearchKeyword}");

        if (ViewBag.FilterStatus != 0)
            queryParams.Add($"filterstatus={ViewBag.FilterStatus}");

        if (ViewBag.CookingStatus != 0)
            queryParams.Add($"cookingstatus={ViewBag.CookingStatus}");

        if (ViewBag.CatId != 0)
            queryParams.Add($"catid={ViewBag.CatId}");

        if (ViewBag.RecipeCatId != 0)
            queryParams.Add($"receipecatid={ViewBag.RecipeCatId}");

        if (ViewBag.RecipeTagId != 0)
            queryParams.Add($"receipetagid={ViewBag.RecipeTagId}");

        if (!string.IsNullOrEmpty(ViewBag.SearchTags))
            queryParams.Add($"searchtags={ViewBag.SearchTags}");

        if (queryParams.Count > 0)
            url += "?" + string.Join("&", queryParams);

        return url;
    }
}
