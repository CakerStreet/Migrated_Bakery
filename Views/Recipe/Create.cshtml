@model CakerStreet.Business.Services.RecipeCreateModel
@using CakerStreet.Business.Services
@{
    ViewData["Title"] = "Add New Recipe";
    var books = ViewBag.RecipeBooks as List<BookItem> ?? new List<BookItem>();
    var cdnBase = ViewBag.CdnBase as string ?? "";
}

@section Head {
    <link href="@(cdnBase)bakery_content/bakery_content/css/sellcss.css?ver=1.14" rel="stylesheet" />
    <link href="@(cdnBase)bakery_content/autocomplete/jquery-ui.min.css" rel="stylesheet" />
    <style type="text/css">
        .font-weight-normal {
            font-weight: normal;
        }
        .img img {
            max-height: 60px;
            max-width: 60px;
        }
        .table.prdlstouter {
            margin-top: 20px;
        }
        .ui-menu img {
            width: 40px;
            height: 40px;
        }
        .ui-menu li span {
            font-size: 1em;
            padding: 0 0 10px 10px;
            margin: 0 0 10px 0 !important;
            white-space: nowrap;
        }
        .orderWrappernew {
            background: #fff;
            border: 1px solid #e3e3e3;
            border-radius: 4px;
            margin-bottom: 20px;
            padding: 0;
            box-shadow: 0 1px 1px rgba(0,0,0,.05);
        }
        .innerhead {
            background-color: #f5f5f5;
            border-bottom: 1px solid #e3e3e3;
            padding: 10px 15px;
            display: flex;
            align-items: center;
        }
        .innerhead h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 500;
            color: #df3f42;
        }
        .innerhead a {
            color: #333;
            margin-right: 15px;
            font-size: 14px;
        }
        .form-horizontal {
            padding: 20px 15px;
        }
        .text-danger.small {
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin" id="divspecification">
        <div class="col-md-12 panel-collapse collapse in" id="collapse3" aria-expanded="true">
            <div class="clearfix"></div>

            <div class="orderWrappernew">
                <div class="innerhead">
                    <a data-toggle="collapse" href="#collapse2" aria-expanded="true">
                        <span class="glyphicon glyphicon-minus"></span>
                    </a>
                    <h2>Add New Recipe</h2>
                </div>

                <div class="col-md-12 panel-collapse collapse in" id="collapse2" aria-expanded="true">
                    <form asp-action="Create" asp-controller="Recipe" method="post" class="form-horizontal">
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" style="margin-top: 15px;">
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div>
                        }

                        <div class="form-group">
                            <label class="col-sm-2 control-label">Title *</label>
                            <div class="col-sm-3">
                                <input asp-for="Title" class="form-control" placeholder="Recipe Title" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-2 control-label">Price *</label>
                            <div class="col-sm-3">
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Price" required />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-2 control-label">Select Book *</label>
                            <div class="col-sm-3">
                                <select asp-for="BookId" class="form-control" id="ddlBook" required>
                                    <option value="">--Select Book--</option>
                                    @foreach (var book in books)
                                    {
                                        <option value="@book.BookId">@book.BookName</option>
                                    }
                                </select>
                                <span asp-validation-for="BookId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-2 control-label">Select Chapter *</label>
                            <div class="col-sm-3">
                                <select asp-for="ChapterId" class="form-control" id="ddlChapter" required>
                                    <option value="">--Select Chapter--</option>
                                </select>
                                <span asp-validation-for="ChapterId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-3">
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" asp-for="IsCooking" /> Is Cooking
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-2 control-label">Servings *</label>
                            <div class="col-sm-3">
                                <input asp-for="Servings" type="number" class="form-control" placeholder="e.g 10" required />
                                <span asp-validation-for="Servings" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-3">
                                <button type="submit" class="btn btn-danger btn-sm bg-red">Save Details</button>
                                <a href="/managereceipe" class="btn btn-danger btn-sm bg-red">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
                
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>

@section FooterScripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Trigger cascading chapters loading
            $('#ddlBook').change(function () {
                var bookId = $(this).val();
                var $chapterDropdown = $('#ddlChapter');
                
                // Clear existing options
                $chapterDropdown.empty();
                $chapterDropdown.append('<option value="">--Select Chapter--</option>');
                
                if (bookId && bookId !== "0") {
                    $.getJSON('/managereceipe/chapters', { bookId: bookId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                $chapterDropdown.append($('<option>', {
                                    value: item.chapterId,
                                    text: item.chapterName
                                }));
                            });
                        }
                    });
                }
            });
        });
    </script>
}
