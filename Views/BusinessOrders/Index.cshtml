@* === MANAGE INGREDIENTS MODAL (matching legacy dvAddIngredients) === *@
<div class="modal fade" id="dvAddIngredients" tabindex="-1" role="dialog" data-orddetid="0" data-ordid="0">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #DF3F42;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true" style="color:#fff;">&times;</span></button>
                <h4 class="modal-title" style="color: #fff;">Manage Ingredients - #<span id="ltIngOrderID"></span></h4>
