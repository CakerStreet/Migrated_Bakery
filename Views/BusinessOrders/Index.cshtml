                </div>
                <div class="form-group">
                    <label><input type="checkbox" id="chkNotifyCustomer" checked /> Notify Customer</label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" onclick="submitCancelOrder()">Cancel Order</button>
                <button class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* === ORDER REVIEWS MODAL === *@
