@section FooterScripts {
<script type="text/javascript">
    // === HAS TOPPER / EDIBLE / NON-EDIBLE (matching legacy jsbakeryorders.js) ===
    $(document).on("click", ".chkHasTopper", function () {
        var orderid = $(this).attr("data-oid");
        var orderdetailid = $(this).attr("data-odetid");
        if ($(this).is(":checked")) {
            $(".rbEdible_" + orderdetailid).prop('checked', true);
            $(".rbNonEdible_" + orderdetailid).prop('checked', false);
            $(".dvTopperType_" + orderdetailid).show();
        } else {
            $(".dvTopperType_" + orderdetailid).hide();
        }
        SaveOrderTopperType($(this).is(":checked"), 1, orderid, orderdetailid);
    });

    $(document).on("change", ".rbEdible, .rbNonEdible", function () {
        var orderid = $(this).attr("data-oid");
        var orderdetailid = $(this).attr("data-odetid");
        var hastopper = $(".chkHasTopper[data-odetid='" + orderdetailid + "']").is(":checked");
        var edible = $(".rbEdible_" + orderdetailid).is(":checked");
        var nonedible = $(".rbNonEdible_" + orderdetailid).is(":checked");
        var typeid = 1;
        if (edible && nonedible) { typeid = 3; }
        else if (nonedible && !edible) { typeid = 2; }
        else if (!edible && !nonedible) {
            hastopper = false;
            $(".chkHasTopper[data-odetid='" + orderdetailid + "']").prop('checked', false);
            $(".dvTopperType_" + orderdetailid).hide();
        }
        SaveOrderTopperType(hastopper, typeid, orderid, orderdetailid);
    });

    function SaveOrderTopperType(hastopper, typeid, orderid, orderdetailid) {
        $.ajax({
            type: "POST",
            url: "/businessorders/savetopper",
            data: JSON.stringify({ orderId: parseInt(orderid), orderDetailId: parseInt(orderdetailid), hasTopper: hastopper, topperTypeId: typeid }),
            contentType: "application/json",
            error: function () { alert('Failed to save topper type.'); }
        });
    }

    // === SELECT ALL / BULK ACTIONS ===
    function toggleSelectAll(el) {
        $('.chkOrder').prop('checked', $(el).prop('checked'));
    }

    function getSelectedOrderIds() {
        var ids = [];
        $('.chkOrder:checked').each(function () { ids.push(parseInt($(this).val())); });
        return ids;
    }

    function bulkAction(newStatus) {
        var ids = getSelectedOrderIds();
        if (ids.length === 0) { alert('Please select at least one order.'); return; }
        var statusNames = { 2: 'Order Processed', 3: 'Under Delivery', 4: 'Completed', 5: 'Job Assigned' };
        if (!confirm('Apply "' + (statusNames[newStatus] || '') + '" to ' + ids.length + ' selected order(s)?')) return;
        var completed = 0;
        ids.forEach(function (id) {
            $.ajax({
                type: "POST", url: "/businessorders/status",
                data: JSON.stringify({ orderId: id, newStatus: newStatus }),
                contentType: "application/json", async: false,
                success: function () { completed++; }
            });
        });
        alert(completed + ' order(s) updated.');
        location.reload();
    }

    function bulkDelete() {
        var ids = getSelectedOrderIds();
        if (ids.length === 0) { alert('Please select at least one order.'); return; }
        if (!confirm('Remove ' + ids.length + ' selected order(s)? This cannot be undone.')) return;
        var completed = 0;
        ids.forEach(function (id) {
            $.ajax({
                type: "POST", url: "/businessorders/delete",
                data: JSON.stringify({ orderId: id }),
                contentType: "application/json", async: false,
                success: function () { completed++; }
            });
        });
        alert(completed + ' order(s) removed.');
        location.reload();
    }

    // === CLICK NEW IMAGE ===
    $(document).on("change", ".chkChangeOrderImage", function () {
        var orderDetailId = $(this).attr("data-orderdetailid");
        var isChecked = $(this).is(":checked");
        $.ajax({
            type: "POST", url: "/businessorders/markchangeimage",
            data: JSON.stringify({ orderDetailId: parseInt(orderDetailId), markForChange: !isChecked }),
            contentType: "application/json",
            error: function () { alert('Failed to update image mark.'); }
        });
    });

    // === ORDER REVIEWS ===
    function openReviewModal(orderId) {
        $('#reviewOrderId').val(orderId);
        $('#drpStars').val('0');
        $('#txtReviewRemarks').val('');
        $('#reviewOrderModal').modal('show');
    }

    function submitReview() {
        var orderId = parseInt($('#reviewOrderId').val());
        var stars = parseInt($('#drpStars').val());
        var remarks = $('#txtReviewRemarks').val().trim();

        $.ajax({
            type: "POST",
            url: "/businessorders/savereview",
            data: JSON.stringify({ orderId: orderId, stars: stars, remarks: remarks }),
            contentType: "application/json",
            success: function (result) {
                if (result.success) {
                    $('#reviewOrderModal').modal('hide');
                    location.reload();
                } else {
                    alert(result.message || 'Failed to save review.');
                }
            },
            error: function () { alert('Server error.'); }
        });
    }

    function updateOrderStatus(orderId, newStatus) {
        var statusNames = { 2: 'Order Processed', 3: 'Order Under Delivery', 4: 'Order Completed', 5: 'Job Assigned' };
        var label = statusNames[newStatus] || ('status ' + newStatus);
        if (!confirm('Are you sure you want to change this order to "' + label + '"?')) return;
        $.ajax({
            type: "POST",
            url: "/businessorders/status",
            data: JSON.stringify({ orderId: orderId, newStatus: newStatus }),
            contentType: "application/json",
            success: function (result) {
                if (result.success) { location.reload(); }
                else { alert(result.message || 'Failed to update status.'); }
            },
            error: function () { alert('Server error. Please try again.'); }
        });
    }

    function confirmOrder(orderId) {
        if (!confirm('Are you sure you want to confirm this order?')) return;
        $.ajax({
            type: "POST",
            url: "/businessorders/confirm",
            data: JSON.stringify({ orderId: orderId }),
            contentType: "application/json",
            success: function (result) {
                if (result.success) { location.reload(); }
                else { alert(result.message || 'Failed to confirm order.'); }
            },
            error: function () { alert('Server error. Please try again.'); }
        });
    }

    function deleteOrder(orderId) {
        if (!confirm('Are you sure you want to remove this order? This cannot be undone.')) return;
        $.ajax({
            type: "POST",
            url: "/businessorders/delete",
            data: JSON.stringify({ orderId: orderId }),
            contentType: "application/json",
            success: function (result) {
                if (result.success) { location.reload(); }
                else { alert(result.message || 'Failed to remove order.'); }
            },
            error: function () { alert('Server error. Please try again.'); }
        });
    }

    // === CANCEL ORDER ===
    var cancelOrderId = 0;

    function openCancelModal(orderId) {
        cancelOrderId = orderId;
        $('#cancelOrderId').text(orderId);
        $('#ddlCancelReason').val('0');
        $('#txtCancelComments').val('');
        $('#chkNotifyCustomer').prop('checked', true);
        $('#cancelOrderModal').modal('show');
    }

    function submitCancelOrder() {
        var reason = $('#ddlCancelReason').val();
        var comments = $('#txtCancelComments').val().trim();
        if (reason === '0') { alert('Please select a cancel reason.'); return; }
        if (!comments) { alert('Please provide cancel description.'); return; }

        $.ajax({
            type: "POST",
            url: "/businessorders/cancel",
            data: JSON.stringify({
                orderId: cancelOrderId,
                reason: reason,
                comments: comments,
                notifyCustomer: $('#chkNotifyCustomer').is(':checked')
            }),
            contentType: "application/json",
            success: function (result) {
                if (result.success) {
                    $('#cancelOrderModal').modal('hide');
                    if (result.warnings && result.warnings.length > 0) {
                        alert('Order cancelled.\n\nNote: ' + result.warnings.join('\n'));
                    }
                    location.reload();
                } else {
                    alert(result.message || 'Failed to cancel order.');
                }
            },
            error: function () { alert('Server error. Please try again.'); }
        });
    }

    // === DATE VALIDATION (matching legacy CompareValidator) ===
    function validateDateFields() {
        var sdateVal = $('.order-from').val().trim();
        var edateVal = $('.order-to').val().trim();
        if (sdateVal && !isValidDate(sdateVal)) {
            alert('Invalid start date. Please use dd/mm/yyyy format.');
            return false;
        }
        if (edateVal && !isValidDate(edateVal)) {
            alert('Invalid end date. Please use dd/mm/yyyy format.');
            return false;
        }
        if (sdateVal && edateVal) {
            var sd = parseDate(sdateVal);
            var ed = parseDate(edateVal);
            if (sd && ed && sd > ed) {
                alert('Start date should be less than end date.');
                return false;
            }
        }
        return true;
    }

    function isValidDate(str) {
        var parts = str.split('/');
        if (parts.length !== 3) return false;
        var d = parseInt(parts[0], 10), m = parseInt(parts[1], 10), y = parseInt(parts[2], 10);
        if (isNaN(d) || isNaN(m) || isNaN(y)) return false;
        var dt = new Date(y, m - 1, d);
        return dt.getFullYear() === y && dt.getMonth() === m - 1 && dt.getDate() === d;
    }

    function parseDate(str) {
        var parts = str.split('/');
        if (parts.length !== 3) return null;
        return new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
    }

    // === UPDATE SORTING (matching legacy moveupward/movedownward/updatesorting) ===
    function moveupward(el) {
        var thisRow = $(el).closest('tr');
        var prevRow = thisRow.prev();
        if (prevRow.length) {
            prevRow.before(thisRow);
            $(el).closest('table').find('tr').removeClass('bg');
            thisRow.addClass('bg');
        }
        $('.updatesorting_outer').show();
    }

    function movedownward(el) {
        var thisRow = $(el).closest('tr');
        var nextRow = thisRow.next();
        if (nextRow.length) {
            nextRow.after(thisRow);
            $(el).closest('table').find('tr').removeClass('bg');
            thisRow.addClass('bg');
        }
        $('.updatesorting_outer').show();
    }

    function updatesorting() {
        var arr = [];
        var counter = 0;
        $('.trOrderlist').each(function () {
            arr.push({ OrderID: parseInt($(this).attr('data-id')), Ordersts: 5, DisplayOrder: counter + 1 });
            counter++;
        });
        $.ajax({
            type: 'POST',
            url: '/businessorders/updatesorting',
            data: JSON.stringify({ items: arr }),
            contentType: 'application/json',
            success: function () { location.reload(); },
            error: function () { alert('Failed to update sorting.'); }
        });
    }

    // === VIEW / EDIT INGREDIENTS POPUP (matching legacy ViewIngredients_popup) ===
    function ViewIngredients_popup(el, ordID, orddetID) {
        $('#dvAddIngredients').attr('data-orddetid', orddetID);
        $('#dvAddIngredients').attr('data-ordid', ordID);
        $('#drptasktype_ingpopup').val('0');
        $('#txtBatchID_Ing').val('');
        $('#ltIngOrderID').text(ordID);
        getingredientlist_popup(orddetID);
    }

    function getingredientlist_popup(orderdetID) {
        $.ajax({
            type: 'POST',
            url: '/businessorders/ingredients',
            data: JSON.stringify({ orderDetailId: parseInt(orderdetID) }),
            contentType: 'application/json',
            success: function (result) {
                if (result.success) {
                    var html = '';
                    if (result.items && result.items.length > 0) {
                        html = '<table class="table table-condensed"><thead><tr><th>Section</th><th>Batch No</th><th>Product</th><th>Date</th><th></th></tr></thead><tbody>';
                        $.each(result.items, function (i, item) {
                            html += '<tr><td>' + item.sectionName + '</td><td>' + item.batchId + '</td><td>' + (item.productName || '-') + '</td><td>' + (item.createDate ? new Date(item.createDate).toLocaleDateString() : '-') + '</td>';
                            html += '<td><a href="javascript:void(0);" onclick="btnremIng_popup_Click(' + item.id + ')" class="text-danger">Remove</a></td></tr>';
                        });
                        html += '</tbody></table>';
                    } else {
                        html = '<p class="text-muted">No ingredients added yet.</p>';
                    }
                    $('#ingredientList_popup').html(html);
                    $('#dvAddIngredients').modal('show');
                } else {
                    alert(result.message || 'Failed to load ingredients.');
                }
            },
            error: function () { alert('Server error loading ingredients.'); }
        });
    }

    function btnAddIng_popup_Click() {
        var batchId = $('#txtBatchID_Ing').val().trim();
        if (!batchId) { alert('Please Enter Batch No.'); return; }
        var orddetID = $('#dvAddIngredients').attr('data-orddetid');
        var ordID = $('#dvAddIngredients').attr('data-ordid');
        var sectionId = parseInt($('#drptasktype_ingpopup').val());
        $.ajax({
            type: 'POST',
            url: '/businessorders/addingredient',
            data: JSON.stringify({ orderDetailId: parseInt(orddetID), orderId: parseInt(ordID), batchId: batchId, sectionId: sectionId }),
            contentType: 'application/json',
            success: function (result) {
                if (result.success) {
                    $('#txtBatchID_Ing').val('');
                    getingredientlist_popup(orddetID);
                } else {
                    alert(result.message || 'Failed to add ingredient.');
                }
            },
            error: function () { alert('Server error adding ingredient.'); }
        });
    }

    function btnremIng_popup_Click(ingredientId) {
        if (!confirm('Remove this ingredient?')) return;
        var orddetID = $('#dvAddIngredients').attr('data-orddetid');
        $.ajax({
            type: 'POST',
            url: '/businessorders/removeingredient',
            data: JSON.stringify({ ingredientId: ingredientId }),
            contentType: 'application/json',
            success: function (result) {
                if (result.success) {
                    getingredientlist_popup(orddetID);
                } else {
                    alert(result.message || 'Failed to remove ingredient.');
                }
            },
            error: function () { alert('Server error removing ingredient.'); }
        });
    }
</script>
}