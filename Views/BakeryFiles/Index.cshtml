@section FooterScripts {
    <input type="hidden" id="hdGlobalUrl" value="" />
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/dropzone.min.js?version=1.02"></script>
    <script src="/Scripts/custom/AjaxFileupload.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('body').on('click', '#ancPlus', function () {
                var $qty = $(this).prev();
                var max = parseInt($qty.attr('data-max'));
                var currentVal = parseInt($qty.val());
                if (!isNaN(currentVal)) {
                    if (currentVal + 1 <= max) {
                        $qty.val(currentVal + 1);
                    }
                }
                else { $qty.val('0'); }
