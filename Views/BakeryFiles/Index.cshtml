            $('body').on('click', '#saveproductdocuments', function () {
                var alerttext = "";
                $(".div_productfile").each(function () {
                    if ($(this).is(':visible')) {
                        if ($(this).find('input#txtProductFileTitle').val() == '') {
                            alerttext += "Please Enter Document Title.\n\r";
                            $(this).find('input#txtProductFileTitle').addClass("redcolored");
                        }
                        if ($(this).find('input#hfProductFileName').val() == '') {
                            alerttext += "Please Upload Document.\n\r";
                            $(this).find('input#fuPrdFile').addClass("redcolored");
                        }
                    }
                });

                if (alerttext != "") {
                    alert(alerttext);
                }
                else {
                    var intcountertiming = 0;
                    var lstPM = new Array();

                    $(".div_productfile").each(function () {
                        var var_prddoc = {};
                        var_prddoc.RecNo = 1;
                        var_prddoc.ProductFileID = parseInt($(this).find('#hfProductFileID').val() || '0');
                        var_prddoc.OrderId = parseInt($('#hfOrderID').val() || '0');
                        var_prddoc.OrderDetailID = parseInt($('#hfOrderDetailID').val() || '0');
                        var_prddoc.ProductId = parseInt($('#hfProductId').val() || '0');
                        var_prddoc.ProductFileTitle = $(this).find('#txtProductFileTitle').val();
                        var_prddoc.IsDeleted = parseInt($(this).find('#hfPrfFileDeleted').val() || '0');
                        var_prddoc.ProductFile = $(this).find('#hfProductFileName').val();
                        lstPM[intcountertiming] = var_prddoc;
                        intcountertiming += 1;
                    });

                    $.ajax({
                        type: "POST",
                        url: "/bakeryfiles/SaveBakeryDocument",
                        data: JSON.stringify({ lstPM: lstPM }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (msg) {
                            var city = msg.d;
                            if (city.data_ID == 1) {
                                alert('Bakery document(s) have been uploaded successfully!');
                                location.reload();
                            }
                            else {
                                alert(city.data_optionalstr);
                            }
                        },
                        error: function (x, e) {
                            alert("The call to the server side failed. " + x.responseText);
                        }
                    });
                }
            });

