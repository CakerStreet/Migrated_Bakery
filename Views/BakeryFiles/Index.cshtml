@using CakerStreet.Business.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "CRM Manage Order - Bakery Files";
    var info = ViewBag.OrderInfo as BakeryFilesOrderInfo;
    var orderId = ViewBag.OrderId;
    var orderDetailId = ViewBag.OrderDetailId;
    var productId = ViewBag.ProductId;
    var cdnBase     = (ViewBag.CdnBase as string ?? "https://www.cakerstreet.com").TrimEnd('/');
    var imgCdn      = (ViewBag.ProductImageCdn as string ?? cdnBase).TrimEnd('/');
}

@functions {
    public string GetDocumentImgUrl(string cdnBase, string productId, string fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return "/img/icons/rar.png";
        string fnLower = fileName.ToLower();
        if (fnLower.EndsWith(".zip") || fnLower.EndsWith(".rar")) return "/img/icons/rar.png";
        if (fnLower.EndsWith(".psd") || fnLower.EndsWith(".studio3") || fnLower.EndsWith(".ai")) return "/img/icons/psd.png";
        if (fnLower.EndsWith(".otf") || fnLower.EndsWith(".ttf") || fnLower.EndsWith(".fnt")) return "/img/icons/font.png";
        if (fnLower.EndsWith(".pdf")) return "/img/icons/pdf.png";
        if (fnLower.EndsWith(".svg")) return "/img/icons/svg.png";
        return cdnBase + "/upload/sku/" + productId + "/files/" + fileName;
    }
    public string GetPrdSmlImage(string cdnBase, string image)
    {
        if (string.IsNullOrEmpty(image)) return "/images/blankImages/110x135.jpg";
        return cdnBase + "/upload/Product_images/resized_80_80/" + image;
    }
}

