@model CakerStreet.Business.Services.SearchTagListResult
@using CakerStreet.Business.Controllers
@{
    ViewData["Title"] = "CRM Search Tag";
    var msg = TempData["Message"]?.ToString();
}
<div class="container-fluid py-3">

    @* ── Header ──────────────────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="fas fa-tags"></i> Manage Search Tags</h4>
        <a href="/" class="text-muted small" target="_blank">www.cakerstreet.com</a>
    </div>

    @* ── Message Panel (matches legacy pnlMsg / lblMainMsg) ─────────────────── *@
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert alert-info alert-dismissible fade show py-2" role="alert">
            @msg
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Search/Filter Panel ────────────────────────────────────────────────── *@
    <form method="get" action="/crmsearchtag" class="card mb-3">
        <div class="card-body py-2">
            <div class="form-group row mb-2">
                <label class="col-sm-2 col-form-label"><strong>Search Tags For</strong></label>
                <div class="col-sm-6">
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="searchfor" id="sf0" value="0" @(Model.SearchFor == 0 ? "checked" : "") autocomplete="off">
                        <label class="btn btn-sm btn-outline-primary" for="sf0"><i class="fas fa-birthday-cake"></i> Cakes</label>
                        <input type="radio" class="btn-check" name="searchfor" id="sf1" value="1" @(Model.SearchFor == 1 ? "checked" : "") autocomplete="off">
                        <label class="btn btn-sm btn-outline-primary" for="sf1"><i class="fas fa-cookie"></i> Cup Cakes</label>
                        <input type="radio" class="btn-check" name="searchfor" id="sf2" value="2" @(Model.SearchFor == 2 ? "checked" : "") autocomplete="off">
                        <label class="btn btn-sm btn-outline-primary" for="sf2"><i class="fas fa-gift"></i> Party Accessory</label>
                    </div>
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-sm-2 col-form-label"><strong>Keyword</strong></label>
                <div class="col-sm-3">
                    <input type="text" name="filterp" value="@Model.FilterP" class="form-control form-control-sm" placeholder="Search by keyword" />
                </div>
                <div class="col-sm-3">
                    <select name="rdsearchtype" class="form-select form-select-sm">
                        <option value="0" @(Model.SearchType == 0 ? "selected" : "")>Keyword Anywhere</option>
                        <option value="1" @(Model.SearchType == 1 ? "selected" : "")>Keyword Starts with</option>
                        <option value="2" @(Model.SearchType == 2 ? "selected" : "")>Keyword Ends with</option>
                        <option value="3" @(Model.SearchType == 3 ? "selected" : "")>Exact Keyword</option>
                    </select>
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-sm-2 col-form-label"><strong>Status</strong></label>
                <div class="col-sm-6">
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="status" id="st0" value="0" @(Model.Status == 0 ? "checked" : "") autocomplete="off">
                        <label class="btn btn-sm btn-outline-secondary" for="st0">All</label>
                        <input type="radio" class="btn-check" name="status" id="st1" value="1" @(Model.Status == 1 ? "checked" : "") autocomplete="off">
                        <label class="btn btn-sm btn-outline-success" for="st1">Active</label>
                        <input type="radio" class="btn-check" name="status" id="st2" value="2" @(Model.Status == 2 ? "checked" : "") autocomplete="off">
                        <label class="btn btn-sm btn-outline-danger" for="st2">Inactive</label>
                    </div>
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-sm-2 col-form-label"><strong>Sort</strong></label>
                <div class="col-sm-3">
                    <select name="sort" class="form-select form-select-sm">
                        <option value="0" @(Model.Sort == 0 ? "selected" : "")>New Arrivals</option>
                        <option value="11" @(Model.Sort == 11 ? "selected" : "")>Default Sort</option>
                        <option value="3" @(Model.Sort == 3 ? "selected" : "")>Popular</option>
                        <option value="1" @(Model.Sort == 1 ? "selected" : "")>Name</option>
                        <option value="2" @(Model.Sort == 2 ? "selected" : "")>Search count (high to Low)</option>
                        <option value="4" @(Model.Sort == 4 ? "selected" : "")>Linked Records(high to Low)</option>
                        <option value="5" @(Model.Sort == 5 ? "selected" : "")>Linked Records(Low to High)</option>
                    </select>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-offset-2 col-sm-6 offset-sm-2">
                    <button type="submit" class="btn btn-sm btn-primary">Go</button>
                    <a href="/crmsearchtag" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            </div>
        </div>
    </form>

    @* ── Results Count ──────────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted">
            <strong>@Model.TotalTags</strong> results found
            &nbsp;|&nbsp; Page @Model.CurrentPage of @Model.TotalPages
        </span>
    </div>

    @* ── Sub-tag breadcrumb bar (matches legacy div_lnktag) ────────────────── *@
    @if (Model.ParentTagId.HasValue && Model.ParentTagId.Value > 0)
    {
        <div class="col-sm-6 alert alert-danger" style="font-size:14px; padding-top:7px; padding-bottom:7px; margin:7px 0 15px">
            <a href="/crmsearchtag" class="text-primary">All Tags</a>
            &gt;
            @Model.ParentTagText
        </div>
    }


    @* ── Top Action Bar (all buttons matching legacy crmsearchtag.aspx) ──── *@
    <div class="btn-toolbar mb-2 flex-wrap" role="toolbar">
        <div class="btn-group btn-group-sm me-2 mb-1">
            <button type="button" class="btn btn-outline-secondary" onclick="checkAll(true)">Select All</button>
            <button type="button" class="btn btn-outline-secondary" onclick="checkAll(false)">Unselect</button>
        </div>
        @* Activate/Deactivate *@
        <div class="btn-group btn-group-sm me-2 mb-1">
            <button type="button" class="btn btn-primary" onclick="bulkAction('bulkactivate')">Activate</button>
            <button type="button" class="btn btn-primary" onclick="bulkAction('bulkdeactivate')">DeActivate</button>
        </div>
        @* Update *@
        <div class="btn-group btn-group-sm me-2 mb-1">
            <button type="button" class="btn btn-primary" onclick="submitUpdate()">Update Record(s)</button>
        </div>
        @* Delete (legacy btnDelete + btnDeletetagsnimages) *@
        <div class="btn-group btn-group-sm me-2 mb-1">
            <button type="button" class="btn btn-primary" onclick="bulkDelete('deletetags')">Delete Tags Only</button>
            <button type="button" class="btn btn-primary" onclick="bulkDelete('deletetagswithimages')">Delete Tags + Images</button>
        </div>
        @* Link/Unlink by Keywords *@
        <div class="btn-group btn-group-sm me-2 mb-1">
            <button type="button" class="btn btn-primary" onclick="openLinkModal('link')">Link Products By Keywords</button>
            <button type="button" class="btn btn-primary" onclick="openLinkModal('unlink')">Unlink Products By Keywords</button>
        </div>
        @* Create/Merge (legacy btncreatenewtag, btnMergetags, btnlinknewtag) *@
        <div class="btn-group btn-group-sm me-2 mb-1">
            <button type="button" class="btn btn-primary" onclick="openCreateTagModal('0')">Add New Search Tag</button>
            <button type="button" class="btn btn-primary" onclick="mergeTags()">Merge Tags</button>
            <button type="button" class="btn btn-primary" onclick="mergeIntoNew()">Link Tags into New/Existed Tags</button>
        </div>
        @* Export (legacy btnExportCSV) *@
        <div class="btn-group btn-group-sm me-2 mb-1">
            <a href="/crmsearchtag/exportcsv?searchfor=@Model.SearchFor&status=@Model.Status&filterp=@Uri.EscapeDataString(Model.FilterP ?? "")&rdsearchtype=@Model.SearchType&sort=@Model.Sort" class="btn btn-primary">Export to Excel Sheet</a>
        </div>
        @* View All *@
        <div class="btn-group btn-group-sm mb-1">
            <a href="/crmsearchtag" class="btn btn-primary">View All</a>
        </div>
    </div>

    @* ── Data Table (Phase 2: editable fields + action buttons) ──────────── *@
    <form id="frmUpdate" method="post" action="/crmsearchtag/update">
        @* Pass current filter state so redirect preserves context *@
        <input type="hidden" name="searchfor" value="@Model.SearchFor" />
        <input type="hidden" name="status" value="@Model.Status" />
        <input type="hidden" name="filterp" value="@Model.FilterP" />
        <input type="hidden" name="rdsearchtype" value="@Model.SearchType" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="pno" value="@Model.CurrentPage" />

        <table class="table table-sm table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th style="width:35px"><input type="checkbox" id="chkAll" onclick="checkAll(this.checked)" /></th>
                    <th class="col-md-1">Created On</th>
                    <th class="col-md-5">Text</th>
                    <th class="col-md-1">Search Count</th>
                    <th class="col-md-2">Total Records</th>
                    <th class="col-md-2">Downloaded</th>
                    <th class="col-md-1">Sort Order</th>
                    <th class="col-md-1">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tag in Model.Tags)
                {
                    <tr class="@(!tag.IsActive ? "table-warning" : "")">
                        @* Checkbox — used by bulk activate/deactivate *@
                        <td><input type="checkbox" name="selectedTags" value="@tag.TagId" class="chkRow" /></td>

                        @* Created Date *@
                        <td class="small">@(tag.CreatedOn?.ToString("dd/MM/yyyy hh:mm tt") ?? "")</td>

                        @* Text column: editable text + URL + links (matches legacy col-md-5) *@
                        <td>
                            <input type="hidden" name="tagIds" value="@tag.TagId" />
                            <input type="text" name="tagTexts" value="@tag.Text"
                                   class="form-control form-control-sm" style="font-weight:bold" />
                            <input type="text" name="tagUrls" value="@tag.Url"
                                   class="form-control form-control-sm seo" style="font-size:11px; background-color:#f2f2f2; margin-top:5px" />
                        </td>

                        @* Search Count *@
                        <td>@tag.SearchCount</td>

                        @* Total Records (Product Count + View link + Show at Front toggle) *@
                        <td>
                            @tag.ProductCount
                            @{
                                var frontUrl = (Model.SearchFor == 0) ? "cakes" : (Model.SearchFor == 1 ? "cupcakes" : "party-accessories");
                            }
                            <a href="/@frontUrl/q/@tag.Url" target="_blank" class="btn btn-xs btn-danger pull-right" style="float:right; font-size:11px;">View</a>
                            <form method="post" action="/crmsearchtag/togglefront/@tag.TagId" style="display:inline; float:right; margin-right:5px">
                                <input type="hidden" name="searchfor" value="@Model.SearchFor" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <input type="hidden" name="filterp" value="@Model.FilterP" />
                                <input type="hidden" name="rdsearchtype" value="@Model.SearchType" />
                                <input type="hidden" name="sort" value="@Model.Sort" />
                                <input type="hidden" name="pno" value="@Model.CurrentPage" />
                                <button type="submit" class="btn btn-xs @(tag.ShowAtFront ? "btn-success" : "btn-danger")" style="font-size:11px">
                                    @(tag.ShowAtFront ? "Not cleared" : "Cleared")
                                </button>
                            </form>
                        </td>

                        @* Downloaded Count *@
                        <td>@tag.DownloadedCount</td>

                        @* Sort Order (editable, matches legacy txtbox 50px) *@
                        <td>
                            <input type="number" name="tagOrders" value="@tag.DisplayOrder"
                                   class="form-control form-control-sm" style="width:50px" />
                        </td>

                        @* Status + Active/Deactivate toggle (matches legacy litsts + lnkActive) *@
                        <td>
                            @(tag.IsActive ? "Active" : "Inactive")
                            <form method="post" action="/crmsearchtag/toggleactive/@tag.TagId" style="display:inline; float:right">
                                <input type="hidden" name="searchfor" value="@Model.SearchFor" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <input type="hidden" name="filterp" value="@Model.FilterP" />
                                <input type="hidden" name="rdsearchtype" value="@Model.SearchType" />
                                <input type="hidden" name="sort" value="@Model.Sort" />
                                <input type="hidden" name="pno" value="@Model.CurrentPage" />
                                <a href="javascript:void(0)" onclick="this.closest('form').submit()" class="@(tag.IsActive ? "text-danger" : "text-success")" style="margin-right:5px">
                                    @(tag.IsActive ? "Deactivate" : "Activate")
                                </a>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>

    @* ── Bottom Action Bar (legacy had duplicate buttons at bottom) ─────── *@
    <div class="btn-toolbar mb-3" role="toolbar">
        <div class="btn-group btn-group-sm me-2">
            <button type="button" class="btn btn-success" onclick="bulkAction('bulkactivate')">
                <i class="fas fa-check"></i> Activate
            </button>
            <button type="button" class="btn btn-danger" onclick="bulkAction('bulkdeactivate')">
                <i class="fas fa-ban"></i> Deactivate
            </button>
        </div>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-primary" onclick="submitUpdate()">
                <i class="fas fa-save"></i> Update
            </button>
        </div>
    </div>

    @* ── Pagination ──────────────────────────────────────────────────────── *@
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex align-items-center">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@ManageSearchTagsController.BuildPageUrl(Model, 1)">First</a>
                </li>
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@ManageSearchTagsController.BuildPageUrl(Model, Model.CurrentPage - 1)">Prev</a>
                </li>
                @{
                    int startPage = Math.Max(1, Model.CurrentPage - 5);
                    int endPage = Math.Min(Model.TotalPages, startPage + 9);
                    if (endPage - startPage < 9) startPage = Math.Max(1, endPage - 9);
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@ManageSearchTagsController.BuildPageUrl(Model, i)">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@ManageSearchTagsController.BuildPageUrl(Model, Model.CurrentPage + 1)">Next</a>
                </li>
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@ManageSearchTagsController.BuildPageUrl(Model, Model.TotalPages)">Last</a>
                </li>
            </ul>
        </nav>
    }
</div>

<script>
    // Select/unselect all checkboxes (matches legacy checkUncheck)
    function checkAll(checked) {
        document.querySelectorAll('.chkRow').forEach(cb => cb.checked = checked);
        var chkAll = document.getElementById('chkAll');
        if (chkAll) chkAll.checked = checked;
    }

    // Auto-submit filter form on radio/dropdown change (matches legacy AutoPostBack)
    document.querySelectorAll('form.card input[name="searchfor"], form.card input[name="status"]').forEach(function(el) {
        el.addEventListener('change', function() {
            this.closest('form').submit();
        });
    });
    document.querySelector('form.card select[name="sort"]').addEventListener('change', function() {
        this.closest('form').submit();
    });

    // Phase 2: Submit inline update form
    function submitUpdate() {
        document.getElementById('frmUpdate').submit();
    }

    // Phase 2: Bulk activate/deactivate
    function bulkAction(action) {
        var selected = document.querySelectorAll('.chkRow:checked');
        if (selected.length === 0) {
            alert('Please select at least one tag.');
            return;
        }
        if (!confirm('Are you sure you want to ' + action.replace('bulk','') + ' ' + selected.length + ' tag(s)?')) return;

        // Create a form with selected IDs and submit
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/crmsearchtag/' + action;

        selected.forEach(function(cb) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selectedTags';
            input.value = cb.value;
            form.appendChild(input);
        });

        // Pass current filter state
        ['searchfor', 'status', 'filterp', 'rdsearchtype', 'sort', 'pno'].forEach(function(name) {
            var source = document.querySelector('#frmUpdate input[name="' + name + '"]');
            if (source) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = source.value;
                form.appendChild(input);
            }
        });

    document.body.appendChild(form);
        form.submit();
    }
</script>

@* ── Phase 3: Link/Unlink Products by Keywords Modal (matches legacy divLinkPrdByKeyword) ──── *@
<div class="modal fade" id="linkModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="linkModalTitle">Link Products by Keywords</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @* Selected Tags display *@
                <div class="alert alert-secondary py-1 mb-2">
                    <strong>Selected Tags:</strong> <span id="linkSelectedTagNames"></span>
                    <input type="hidden" id="linkTagIds" />
                </div>

                @* Search form (matches legacy: drpprdtypetolink, txtSearchNewPrd, txtExcludeNewPrd) *@
                <div class="row g-2 mb-2">
                    <div class="col-md-2">
                        <select id="linkPrdType" class="form-select form-select-sm">
                            <option value="0">All Products</option>
                            <option value="3">Cakes</option>
                            <option value="6">Cupcakes</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="text" id="linkKeywords" class="form-control form-control-sm" placeholder="Keywords (comma separated)" />
                    </div>
                    <div class="col-md-3">
                        <input type="text" id="linkExcludeKeywords" class="form-control form-control-sm" placeholder="Exclude keywords" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-sm btn-danger" onclick="searchProductsByKeyword()">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                    <div class="col-md-2 text-end">
                        <span id="linkResultCount" class="text-muted small"></span>
                    </div>
                </div>

                @* Results table *@
                <div style="max-height:400px; overflow-y:auto">
                    <table class="table table-sm table-bordered table-striped" id="linkResultsTable">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:35px"><input type="checkbox" id="chkAllPrd" onclick="checkAllPrd(this.checked)" /></th>
                                <th>Product</th>
                                <th style="width:80px">Code</th>
                                <th style="width:80px" class="text-end">Price</th>
                                <th style="width:120px">Linked Tags</th>
                            </tr>
                        </thead>
                        <tbody id="linkResultsBody">
                            <tr><td colspan="5" class="text-center text-muted">Enter keywords and click Search</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSubmitLink" onclick="submitLinkUnlink()">
                    <i class="fas fa-link"></i> Link Products
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Phase 3: Modal state
    var linkMode = 'link'; // 'link' or 'unlink'

    function openLinkModal(mode) {
        var selected = document.querySelectorAll('.chkRow:checked');
        if (selected.length === 0) {
            alert('Please select at least one tag first.');
            return;
        }

        linkMode = mode;
        var ids = [];
        var names = [];
        selected.forEach(function(cb) {
            ids.push(cb.value);
            // Get tag name from the adjacent text input
            var row = cb.closest('tr');
            var textInput = row.querySelector('input[name="tagTexts"]');
            if (textInput) names.push(textInput.value);
        });

        document.getElementById('linkTagIds').value = ids.join(',');
        document.getElementById('linkSelectedTagNames').textContent = names.join(', ');

        var title = mode === 'link' ? 'Link Products by Keywords' : 'Unlink Products by Keywords';
        document.getElementById('linkModalTitle').textContent = title;

        var btn = document.getElementById('btnSubmitLink');
        if (mode === 'link') {
            btn.innerHTML = '<i class="fas fa-link"></i> Link Products';
            btn.className = 'btn btn-primary';
        } else {
            btn.innerHTML = '<i class="fas fa-unlink"></i> Unlink Products';
            btn.className = 'btn btn-warning';
        }

        // Clear previous results
        document.getElementById('linkKeywords').value = '';
        document.getElementById('linkExcludeKeywords').value = '';
        document.getElementById('linkResultsBody').innerHTML =
            '<tr><td colspan="5" class="text-center text-muted">Enter keywords and click Search</td></tr>';
        document.getElementById('linkResultCount').textContent = '';

        // Show modal
        var modal = new bootstrap.Modal(document.getElementById('linkModal'));
        modal.show();
    }

    function searchProductsByKeyword() {
        var keywords = document.getElementById('linkKeywords').value;
        if (!keywords.trim()) { alert('Enter keywords.'); return; }

        var formData = new FormData();
        formData.append('keywords', keywords);
        formData.append('excludeKeywords', document.getElementById('linkExcludeKeywords').value);
        formData.append('productType', document.getElementById('linkPrdType').value);
        formData.append('tagIds', document.getElementById('linkTagIds').value);
        formData.append('unlinkMode', linkMode === 'unlink');

        document.getElementById('linkResultsBody').innerHTML =
            '<tr><td colspan="5" class="text-center"><i class="fas fa-spinner fa-spin"></i> Searching...</td></tr>';

        fetch('/crmsearchtag/searchproductsbykeyword', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(function(data) {
                var tbody = document.getElementById('linkResultsBody');
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No products found</td></tr>';
                    document.getElementById('linkResultCount').textContent = '0 products';
                    return;
                }
                document.getElementById('linkResultCount').textContent = data.length + ' product(s)';
                var html = '';
                data.forEach(function(p) {
                    html += '<tr>';
                    html += '<td><input type="checkbox" class="chkPrd" value="' + p.productId + '" checked /></td>';
                    html += '<td><strong>' + escapeHtml(p.name) + '</strong></td>';
                    html += '<td>' + escapeHtml(p.code) + '</td>';
                    html += '<td class="text-end">' + (p.price > 0 ? '£' + p.price.toFixed(2) : '-') + '</td>';
                    html += '<td class="small">' + escapeHtml(p.linkedTagIds) + '</td>';
                    html += '</tr>';
                });
                tbody.innerHTML = html;
            })
            .catch(function(err) {
                document.getElementById('linkResultsBody').innerHTML =
                    '<tr><td colspan="5" class="text-center text-danger">Error: ' + err + '</td></tr>';
            });
    }

    function checkAllPrd(checked) {
        document.querySelectorAll('.chkPrd').forEach(cb => cb.checked = checked);
    }

    function submitLinkUnlink() {
        var selectedPrds = document.querySelectorAll('.chkPrd:checked');
        if (selectedPrds.length === 0) { alert('Select at least one product.'); return; }

        var action = linkMode === 'link' ? 'bulklink' : 'bulkunlink';
        var verb = linkMode === 'link' ? 'link' : 'unlink';
        if (!confirm('Are you sure you want to ' + verb + ' ' + selectedPrds.length + ' product(s)?')) return;

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/crmsearchtag/' + action;

        // Tag IDs
        var tagInput = document.createElement('input');
        tagInput.type = 'hidden'; tagInput.name = 'tagIds';
        tagInput.value = document.getElementById('linkTagIds').value;
        form.appendChild(tagInput);

        // Product IDs
        selectedPrds.forEach(function(cb) {
            var input = document.createElement('input');
            input.type = 'hidden'; input.name = 'productIds'; input.value = cb.value;
            form.appendChild(input);
        });

        // Current filter state
        ['searchfor', 'status', 'filterp', 'rdsearchtype', 'sort', 'pno'].forEach(function(name) {
            var source = document.querySelector('#frmUpdate input[name="' + name + '"]');
            if (source) {
                var input = document.createElement('input');
                input.type = 'hidden'; input.name = name; input.value = source.value;
                form.appendChild(input);
            }
        });

        document.body.appendChild(form);
        form.submit();
    }

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }

    // ── Delete (legacy btnDelete_Click / btnDeletetagsnimages_Click) ──────────
    function bulkDelete(action) {
        var checked = document.querySelectorAll('.chkTag:checked');
        if (checked.length === 0) { alert('Select at least one tag.'); return; }
        var label = action === 'deletetags' ? 'Delete tags only' : 'Delete tags AND images';
        if (!confirm(label + '?\n\nThis will permanently delete ' + checked.length + ' tag(s). Continue?')) return;

        var ids = [];
        checked.forEach(function(cb) { ids.push(cb.value); });

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/crmsearchtag/' + action;

        var tagInput = document.createElement('input');
        tagInput.type = 'hidden'; tagInput.name = 'tagIds'; tagInput.value = ids.join(',');
        form.appendChild(tagInput);

        appendFilterInputs(form);
        document.body.appendChild(form);
        form.submit();
    }

    // ── Merge Tags (legacy btnMergetags_onClick) ─────────────────────────────
    function mergeTags() {
        var checked = document.querySelectorAll('.chkTag:checked');
        if (checked.length < 2) { alert('Select at least 2 tags to merge.'); return; }
        if (!confirm('Merge ' + checked.length + ' tags? All products will be linked to the first selected tag.')) return;

        var ids = [];
        checked.forEach(function(cb) { ids.push(cb.value); });

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/crmsearchtag/mergetags';

        var tagInput = document.createElement('input');
        tagInput.type = 'hidden'; tagInput.name = 'tagIds'; tagInput.value = ids.join(',');
        form.appendChild(tagInput);

        appendFilterInputs(form);
        document.body.appendChild(form);
        form.submit();
    }

    // ── Merge into New (legacy btnlinknewtag_Click → shows popup) ────────────
    function mergeIntoNew() {
        var checked = document.querySelectorAll('.chkTag:checked');
        if (checked.length === 0) { alert('Select at least one tag.'); return; }

        var ids = [];
        checked.forEach(function(cb) { ids.push(cb.value); });

        openCreateTagModal(ids.join(','));
    }

    // ── Create Tag Modal (legacy dvCancelOrder popup) ────────────────────────
    function openCreateTagModal(tagIds) {
        var isNew = (tagIds === '0');
        document.getElementById('createTagHeader').textContent = isNew
            ? 'Add new search tag'
            : 'Link Tags into New/Existed Tags';
        document.getElementById('createTagIds').value = tagIds;
        document.getElementById('createTagKeyword').value = '';
        document.getElementById('createTagModal').style.display = 'block';
    }

    function closeCreateTagModal() {
        document.getElementById('createTagModal').style.display = 'none';
    }

    function submitCreateTag() {
        var keyword = document.getElementById('createTagKeyword').value.trim();
        if (!keyword) { alert('Enter a tag keyword.'); return; }

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/crmsearchtag/createtag';

        var addField = function(name, value) {
            var inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = name; inp.value = value;
            form.appendChild(inp);
        };
        addField('tagKeyword', keyword);
        addField('tagIds', document.getElementById('createTagIds').value);
        addField('searchTagFor', document.querySelector('#frmUpdate input[name="searchfor"]')?.value || '0');

        appendFilterInputs(form);
        document.body.appendChild(form);
        form.submit();
    }

    // ── Helper: append current filter inputs to any form ─────────────────────
    function appendFilterInputs(form) {
        ['searchfor', 'status', 'filterp', 'rdsearchtype', 'sort', 'pno'].forEach(function(name) {
            var source = document.querySelector('#frmUpdate input[name="' + name + '"]');
            if (source) {
                var input = document.createElement('input');
                input.type = 'hidden'; input.name = name; input.value = source.value;
                form.appendChild(input);
            }
        });
    }
</script>

@* ── Create Tag Modal (matches legacy dvCancelOrder popup) ───────────────── *@
<div id="createTagModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050;">
    <div style="margin:100px auto; max-width:500px; background:#fff; padding:20px; border-radius:4px;">
        <h5 id="createTagHeader">Add new search tag</h5>
        <input type="hidden" id="createTagIds" value="0" />
        <div class="mb-3">
            <label class="form-label">Tag Keyword</label>
            <input type="text" id="createTagKeyword" class="form-control" placeholder="Enter tag keyword" />
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary btn-sm" onclick="submitCreateTag()">Submit</button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeCreateTagModal()">Cancel</button>
        </div>
    </div>
</div>

