@model CakerStreet.Business.Services.OrderImageInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Order Image";

    var imgSrc = Model.ProductImage;
    if (string.IsNullOrEmpty(imgSrc))
    {
        imgSrc = "/img/commingsoon_cake.jpg";
    }
    else if (!imgSrc.StartsWith("http", StringComparison.OrdinalIgnoreCase) && !imgSrc.StartsWith("/", StringComparison.OrdinalIgnoreCase))
    {
        imgSrc = "/upload/Product_images/resized_500_500/" + imgSrc;
    }
}

@section Head {
    <link href="/css/sellcss.css?ver=1.14" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.css" />
    <style type="text/css">
        #dropzoneForm {
            width: 50%;
            margin: 0 auto;
        }
        .div_typewisefilter {
            display: table;
            z-index: 3;
            font-size: 12px;
        }
        .div_typewisefilter.notop {
            top: 0;
        }
        .div_typewisefilter .liupdateglobaldisplayorder > a {
            background-color: #ccc;
            float: left;
            margin-left: 5px;
            opacity: 1;
            padding: 5px;
        }
        .liupdateglobaldisplayorder a img {
            max-width: 18px;
        }
        .div_typewisefilter li {
            display: table;
            opacity: 0.9;
            margin: 5px;
            width: 50px;
        }
        .div_typewisefilter li.liheight {
            height: 20px;
        }
        .div_typewisefilter li.liheight select {
            left: 5px;
            position: absolute;
            top: 5px;
        }
        .div_typewisefilter a {
            background-color: #fff;
            display: inline;
            font-size: 12px;
            opacity: 0.5;
        }
        .div_typewisefilter a > img {
            max-width: 22px;
            max-height: 22px;
        }
        .div_typewisefilter a:hover, .div_typewisefilter a.stt {
            opacity: 1;
        }
        .div_typewisefilter a.stt {
            border-color: Green;
        }
        .div_typewisefilter .divinputprdtext_outer {
            left: 0;
            opacity: 0;
            position: absolute;
            top: -28px;
            width: 250px;
        }
        .div_typewisefilter .divinputprdtext_outer:focus, .div_typewisefilter .divinputprdtext_outer:hover {
            opacity: 1;
        }
        .div_typewisefilter a.ggl {
            padding: 7px 12px;
            background-color: #000;
            color: #fff;
            position: absolute;
            top: 5px;
        }
        .table {
            border: 1px solid #ccc;
            margin: 0px 0 0 0;
        }
        .Toppertabl img {
            padding: 0 5px 7px;
        }
        .table.Toppertabl {
            margin: 0 0 20px 0;
        }
        .table.Toppertabl > thead {
            background-color: #fff;
        }
        .btn-default {
            background-color: #eee;
        }
        .table tbody tr {
            background-color: #eee;
        }
        .table > tbody > tr > td {
            border-top-width: 0;
        }
        .div_deliverydetail {
            margin-bottom: 10px;
            background-color: #aaa;
            color: #fff;
            line-height: 34px;
            padding-top: 7px;
            padding-bottom: 7px;
        }
        .div_backtotop {
            right: auto;
        }
        .div_productfile {
            margin-bottom: 10px;
        }
        .div_Documents {
            display: table;
            width: 100%;
        }
        .divfiles {
            display: table;
            width: 100%;
        }
        .divfiles li {
            float: left;
            line-height: 17px;
            margin: 5px;
            min-height: 34px;
        }
        .divfiles li.imgli {
            border: 1px solid #ccc;
            border-radius: 5px;
            height: 34px;
            margin: 5px 5px 5px 0;
            position: relative;
            width: 34px;
            padding: 0;
            overflow: auto;
        }
        .divfiles li.imgli > img {
            max-height: 100%;
            max-width: 100%;
            padding: 1px;
            position: static;
        }
        .divfiles li.lititle {
            border-width: 0;
            padding: 0;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin" id="divspecification">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-1">
                    <a data-toggle="collapse" href="#collapse3" aria-expanded="true">
                        <span class="glyphicon glyphicon-minus"></span>
                    </a>
                </div>
                <div class="col-md-11">
                    <h2>Bakery Files (#@Model.OrderId)</h2>
                </div>
            </div>
            <div class="col-md-12 panel-collapse collapse in" id="collapse3" aria-expanded="true">
                <input type="hidden" id="hfOrderID" value="@Model.OrderId" />
                <input type="hidden" id="hfProductId" value="@Model.OrderId" />
                <div class="form row-fluid">
                    <div class="form-group col-md-12 caln">
                        <a id="ancprdlink" href="@imgSrc" target="_blank">
                            <img id="imgPrd" src="@imgSrc" style="max-width: 150px; max-height: 150px;" />
                        </a>
                        <br />
                        <strong>@Model.ProductName (@Model.ProductCode)</strong>
                    </div>
                    <div class="form-group col-md-12 caln div_typewisefilter" style="text-align: center;">
                        <a id="lnkDownload" href="/business-order-image/download?file=@Uri.EscapeDataString(Model.ProductImage)&apitype=@Model.ApiType">
                            <img src="/img/download-icon.png" id="ImgDownload" alt="Download" />
                        </a>
                        <a id="ancUploadPrdPic" href="javascript:UploadPicture('@Model.OrderId', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.ProductName))');">
                            <img src="/img/upload-icon.png" id="ImgUpload" alt="Upload" />
                        </a>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dvPicModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="prdTitle"></h4>
            </div>
            <div class="modal-body" style="width: 100%">
                <div role="form" class="form-horizontal box-body">
                    <div class="form-group">
                        <div class="col-sm-12">
                            <div class="dropzone" id="dropzoneForm">
                                <div class="fallback">
                                    <input name="file" type="file" />
                                    <input type="submit" value="Upload" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-4">
                            <input id="btnUpload" class="btn btn-danger btn-block btn-flat btn-sign-in" onclick="UploadFiles();" type="button" value="Upload" />
                            <input id="hdPrdID" type="hidden" />
                            <input id="hdApiType" type="hidden" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section FooterScripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/3.8.4/dropzone.min.js"></script>
    <script src="~/js/dropzone.updateorderimage.js?version=1.03"></script>
    <script src="~/Scripts/custom/AjaxFileupload.js" type="text/javascript"></script>
    <script type="text/javascript">
        function UploadPicture(pid, pname) {
            $("#prdTitle").text(pname);
            $("#hdPrdID").val(pid);
            $("#hdApiType").val("@Model.ApiType");
            $("#dvPicModal").modal('show');
        }
    </script>
}
