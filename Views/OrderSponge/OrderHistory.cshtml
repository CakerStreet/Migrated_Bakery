@model List<CakerStreet.Business.Models.SpongeOrderHistoryItem>

<div class="row top-margin"></div>
<div class="clearfix"></div>

<div class="inventoryWrapper">
    <div class="innerhead">
        <h2 style="display: inline-block;">Manage Sponge Requests</h2>
        <a class="pull-right normallink" style="color: #fff; margin-right: 10px; text-decoration: underline;"
           href="/orderspongelist">Back to Order Sponge</a>
    </div>
    <div class="col-lg-12" style="min-height: 600px; padding-top: 15px;">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">No record found.</div>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead>
                    <tr style="background-color: #f5f5f5;">
                        <th>#</th>
                        <th>Created By</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Total Qty</th>
                        <th>Remarks</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@item.CreatedBy</td>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.TotalQty</td>
                            <td>@item.Remarks</td>
                            <td>@item.ModifiedOn.ToString("dd/MM/yyyy hh:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
