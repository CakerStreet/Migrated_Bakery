@{
    ViewData["Title"] = (bool)(ViewBag.IsEdit ?? false) ? "Edit Product" : "Add New Product";
    var product = ViewBag.Product as CakerStreet.Business.Controllers.AddNewCakeController.ProductEditModel;
    var prdType = (int)(ViewBag.ProductType ?? 1);
    var isEdit = (bool)(ViewBag.IsEdit ?? false);
    var cakeShapes = ViewBag.CakeShapes as List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>
        ?? new List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>();
    var cakeTypes = ViewBag.CakeTypes as List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>
        ?? new List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>();
    var deliverySettings = ViewBag.DeliverySettings as CakerStreet.Business.Controllers.AddNewCakeController.ProductDeliverySettings
        ?? new CakerStreet.Business.Controllers.AddNewCakeController.ProductDeliverySettings();
    var selectedShapeId = (int)(ViewBag.SelectedShapeId ?? 0);
    var selectedTypeId = (int)(ViewBag.SelectedTypeId ?? 0);
    var maxDeliveryMiles = (int)(ViewBag.MaxDeliveryMiles ?? 20);
    var cdnBase = ViewBag.CdnBase as string ?? "";
}

@section Head {
    <link href="https://cakerstreet1.s3.amazonaws.com/bakery_content/css/sellcss.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" rel="stylesheet" />
    <style type="text/css">
        .font-weight-normal { font-weight: normal; }
        div.div_LocationQty { margin-bottom: 3px; }
        .flush { padding-left: 0; padding-right: 0; }
        .no-left-padding { padding-left: 0; }
        .table { margin-bottom: 0; }
        .dvProductSuppliers > .table { border: 1px solid #ccc; }
        .collapsed .icon-class:before { content: '>'; }
        .icon-class:before { content: 'v'; }
        td.icon-class { cursor: pointer; }
        .AddQtyTxtbox { position: absolute; bottom: 0; line-height: 34px; text-align: right; width: 100%; padding-right: 20px; z-index: 1; }
        div.color-swatch { float: right; width: 30px; height: 25px; }
        .chkStoreCategory_outer { display: inline; }
        .chkStoreCategory_outer label { display: inline-block; margin-right: 8px; font-weight: normal; }
        .div_catdrps_ListingOuter select { margin-bottom: 5px; display: inline-block; width: auto; margin-right: 10px; }
        .prd-img-main { display: inline-block; margin-right: 8px; vertical-align: top; }
        /* Legacy photo box styles */
        .divPrdImg_outer { display: table; width: 100%; padding-bottom: 10px; }
        .prdImgbox_outer { display: table; float: left; height: 120px; margin: 0 1% 0 0; overflow: hidden; width: 13.2%; }
        .prdImgbox_outer .prdImgbox { border: 1px solid #ccc; border-radius: 5px; display: table; height: 100px; width: 100%; position: relative; box-sizing: border-box; }
        .prdImgbox_outer.addnewctrl { background-color: #eee; cursor: pointer; height: auto; }
        .prdImgbox_outer .prdImgbox .addPrdImg { background: rgba(0,0,0,0) url('https://cakerstreet1.s3.amazonaws.com/bakery_content/images/camerabig.png') no-repeat scroll center center; border-bottom: 2px solid #aaa; border-radius: 5px; height: 100px; overflow: hidden; position: relative; width: 100%; }
        .prdImgbox_outer .prdImgbox .addPrdImg.addnewctrl { background: rgba(0,0,0,0) none repeat scroll 0 0; }
        .prdImgbox_outer .prdImgbox .addPrdImg > input[type='file'] { border: 0 none; cursor: pointer; height: 100%; left: 0; opacity: 0; position: absolute; right: 0; top: 0; width: 100%; z-index: 1; }
        .prdImgbox_outer .prdImgbox .addPrdImg > span { color: #1a646d; display: block; font-size: 16px; font-weight: 500; line-height: 30px; position: absolute; text-align: center; top: 55%; width: 100%; }
        .prdImgbox_outer .prdImgbox .addPrdImg.addnewctrl > span { color: #aaa; font-size: 50px; line-height: 50px; top: 25%; }
        .prdImgbox_outer .prdImgbox .PrdImg { background-position: center center; background-repeat: no-repeat; background-size: 100% auto; border-radius: 5px; bottom: 1px; box-sizing: border-box; left: 1px; padding: 1px; position: absolute; right: 1px; top: 1px; display: none; }
        .prdImgbox_outer .prdImgbox .edit { background: #eee url('https://cakerstreet1.s3.amazonaws.com/images/icons/pencil-icon.png') no-repeat scroll center center / 18px auto; border: 1px solid #ccc; border-radius: 5px; height: 30px; position: absolute; right: 3px; top: 3px; width: 30px; z-index: 2; display: none; }
        .prdImgbox_outer .prdImgbox .remove { background: #eee url('https://cakerstreet1.s3.amazonaws.com/images/icons/cross-small-icon.png') no-repeat scroll center center / 18px auto; border: 1px solid #ccc; border-radius: 5px; height: 30px; position: absolute; left: 3px; top: 3px; width: 30px; z-index: 2; display: none; }
        .prdImgbox_outer .prdImgbox .spn_radioouter { display: none; position: absolute; bottom: 3px; left: 0; width: 100%; text-align: center; font-size: 11px; z-index: 2; }
        .prdImgbox_outer .prdImgbox .loading { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 30px; }
        .bggrey { background-color: #f5f5f5; padding: 8px; }
        .displaynone { display: none; }
        .div_sizeportion { display: none; position: absolute; top: 24px; width: 200px; z-index: 1; background: #fff; border: 1px solid #ccc; padding: 5px; }
        .div_FlavorsizePrice { display: none; position: absolute; top: 24px; width: 220px; z-index: 1; background: #fff; border: 1px solid #ccc; padding: 5px; }
        .div_SelectionExclist { display: none; position: absolute; top: 24px; width: 200px; z-index: 1; background: #fff; border: 1px solid #ccc; padding: 5px; }
        .btn.black-rounded { background-color: #333; color: #fff; border-radius: 50%; width: 30px; height: 30px; padding: 0; line-height: 30px; text-align: center; font-size: 18px; }
        .btn.black-rounded:hover { background-color: #555; }
        .div_portionouter { background-color: #eee; cursor: pointer; float: left; height: 24px; width: 85px; position: relative; text-align: center; font-size: 12px; line-height: 24px; }
        .div_portionouter .selectdrop { float: right; width: 20px; text-align: center; }
        .Div_sizelitingouter { display: table; padding-bottom: 10px; width: 100%; }
        .divsizebox { clear: both; margin-bottom: 10px; position: relative; }
        .divsizebox:first-child .upward { display: none; }
        .divsizebox .upward, .divsizebox .remouter { position: absolute; right: 16px; top: 0; cursor: pointer; }
        .divsizebox .remouter { line-height: 24px; right: 0; }
        .form-control.gray-input.inputprice { display: inline; max-width: 50px; }
        .Div_flavourPrice, .div_FlavorExclude, .div_SelectionMain { position: relative; display: inline-block; cursor: pointer; }
        .div_flavourmainouter { margin-bottom: 15px; padding: 10px 0; border-bottom: 1px solid #eee; }
        .div_flavourchildbox { margin-bottom: 5px; position: relative; }
        .div_flavourchildbox .upward, .div_flavourchildbox .remouter { position: absolute; right: 16px; top: 0; cursor: pointer; }
        .div_flavourchildbox .remouter { line-height: 24px; right: 0; }
        .div_addnewFlavourouter { padding: 10px 0; clear: both; }
        .addbutouter { padding: 5px 0; clear: both; }
        .no-right-padding { padding-right: 0; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.ckeditor.com/4.25.1-lts/standard/ckeditor.js"></script>
    <script src="https://cdn.ckeditor.com/4.25.1-lts/standard/adapters/jquery.js"></script>
}

<input type="hidden" id="hfPrdID" value="@(product?.ProductId ?? 0)" />
<input type="hidden" id="hfPrdtype" value="@prdType" />
<input type="hidden" id="hfPrdgroupID" value="0" />
<input type="hidden" id="hfTradetype" value="1" />
<input type="hidden" id="hfMaxMilesDelivery" value="@maxDeliveryMiles" />
<input type="hidden" id="hfColorNames" value="" />
<input type="hidden" id="hfColorCodes" value="" />

<div class="row">
    @* ═══ CATEGORIES SECTION (hidden for stock types 4,5 — visible for 1,2,6) ═══ *@
    @if (prdType == 1 || prdType == 6 || prdType == 2 || prdType == 3)
    {
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-7">
                    <h2>Categories where your listing will appear</h2>
                </div>
                <div class="col-md-5">
                    <a href="/mywebstore" class="btn btn-default margin pull-right">Back</a>
                </div>
            </div>
            <div class="col-md-12">
                <p><strong>Website categories</strong></p>
                <div class="form-group form-inline div_catdrps_ListingOuter" id="div_catdrps_ListingOuter">
                    @Html.Raw(ViewBag.CategoryDropdownHtml)
                </div>
                <input type="hidden" id="hfCatIDs" value="@(ViewBag.ProductCatId ?? 0)" />
            </div>
        </div>
    </div>
    }

    @* ═══ DESCRIBE YOUR ITEM SECTION ═════════════════════════════════════════ *@
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-10">
                    <h2>Describe your item</h2>
                </div>
                <div class="col-md-2">
                    <a href="/mywebstore" class="btn btn-default margin pull-right">Back</a>
                </div>
            </div>
            <div class="col-md-12 panel-collapse collapse in" id="collapse2" aria-expanded="true">
                @* ─── Photos (legacy camera-icon boxes) ─── *@
                <div class="col-md-8">
                    <p>
                        <strong>Photos</strong>
                        @if (prdType == 1 || prdType == 6)
                        {
                            <br /><small>Add at least one photo. Use all five photos to show off your item's finest features.</small>
                        }
                    </p>
                </div>
                <div class="clearfix"></div>
                <input type="hidden" id="hdn_Product_Images" value="" />
                <div class="col-md-12">
                    <div class="divPrdImg_outer" id="ul_uploadImages">
                        @{
                            int imgCount = (prdType >= 5 && prdType != 6) ? 1 : 4;
                        }
                        @for (int imgIdx = 1; imgIdx <= imgCount; imgIdx++)
                        {
                            var imgVal = "";
                            if (imgIdx == 1) imgVal = product?.Image1 ?? "";
                            var hasImage = !string.IsNullOrEmpty(imgVal);
                            var boxGuid = Guid.NewGuid().ToString("N");
                            <div class="prdImgbox_outer imgboxouter" data-id="@imgIdx">
                                <div data-bid="0" data-tid="@(hasImage ? imgVal : "0")" class="prdImgbox">
                                    <div class="PrdImg" style="@(hasImage ? $"background-image:url('{cdnBase}{imgVal}');display:block;" : "")">&nbsp;</div>
                                    <div class="addPrdImg" style="@(hasImage ? "display:none;" : "")">
                                        <input type="file" accept="image/*" id="@boxGuid" name="@boxGuid" />
                                        <img class="loading" src="https://cakerstreet1.s3.amazonaws.com/images/loading_wall.gif" alt="loading" />
                                    </div>
                                    <a data-bid="0" class="edit" style="@(hasImage ? "display:block;" : "")">&nbsp;</a>
                                    <a data-bid="0" class="remove" style="@(hasImage ? "display:block;" : "")">&nbsp;</a>
                                    <span class="spn_radioouter" style="@(hasImage ? "display:block;" : "")">
                                        <input type="radio" value="@boxGuid" name="grp_prdImage" id="rd_@boxGuid" @(imgIdx == 1 && hasImage ? "checked" : "") />
                                        <label for="rd_@boxGuid">Main Image</label>
                                    </span>
                                </div>
                            </div>
                        }
                        @if (imgCount < 10)
                        {
                            <div data-id="0" class="prdImgbox_outer addnewctrl">
                                <div class="prdImgbox" data-tid="0" data-bid="0">
                                    <div class="addPrdImg addnewctrl"><span>+</span></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (prdType != 1 && prdType != 6 && !isEdit)
                {
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Or Paste Image Url</label>
                            <input type="text" id="txtImageUrl" class="form-control" placeholder="e.g https://www.amazon.co.uk/Patrol-346170-3D-Figurine-Candle-Blue/dp/B01LZEWSNI" />
                        </div>
                    </div>
                }

                <div class="col-md-12">
                    @* ─── Title ─── *@
                    <div class="form-group">
                        <label for="">Title *</label>
                        <input type="text" id="txtPrdTitle" class="form-control" placeholder="Title" value="@(product?.ProductName ?? "")" />
                    </div>

                    @* ─── Short Description ─── *@
                    <div class="form-group col-md-12 row">
                        <div class="col-md-12 row"><label>Short Description</label></div>
                        <div class="col-md-12 row">
                            <textarea id="txtDescription" class="form-control" rows="3" placeholder="Short Description">@(product?.ShortDescription ?? "")</textarea>
                        </div>
                    </div>

                    @* ─── Shape / Type (legacy: divshapeouter with col-md-3 / col-md-4) ─── *@
                    @if (prdType == 1 || prdType == 6)
                    {
                        <div id="divshapeouter">
                            <div class="form-group col-md-3 no-left-padding">
                                <label for="">Cake Shape *</label>
                                <select id="drpcakeshape" class="form-control">
                                    <option value="-1">--Select Shape--</option>
                                    @foreach (var shape in cakeShapes)
                                    {
                                        <option value="@shape.Id" @(selectedShapeId == shape.Id ? "selected" : "")>@shape.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-4 no-left-padding">
                                <label for="">Cake Type *</label>
                                <select id="drpCaketype" class="form-control">
                                    <option value="-1">--Select Type--</option>
                                    @foreach (var ctype in cakeTypes)
                                    {
                                        <option value="@ctype.Id" @(selectedTypeId == ctype.Id ? "selected" : "")>@ctype.Title</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @* ─── Preparation Day (legacy: separate div_preparationouter) ─── *@
                        <div id="div_preparationouter" class="form-group col-md-4 no-left-padding">
                            <label>Preparation Day *</label>
                            <select id="drpPreparationday" class="form-control">
                                <option value="-2" @(product?.PreparationDay == -2 ? "selected" : "")>Same day (+ 2 hours)</option>
                                <option value="-4" @(product?.PreparationDay == -4 ? "selected" : "")>Same day (+ 4 hours)</option>
                                <option value="-6" @(product?.PreparationDay == -6 ? "selected" : "")>Same day (+ 6 hours)</option>
                                <option value="1" @(product?.PreparationDay == 1 ? "selected" : "")>+1 day</option>
                                <option value="2" @(product?.PreparationDay == 2 ? "selected" : "")>+2 days</option>
                                <option value="3" @(product?.PreparationDay == 3 ? "selected" : "")>+3 days</option>
                                <option value="4" @(product?.PreparationDay == 4 ? "selected" : "")>+4 days</option>
                                <option value="5" @(product?.PreparationDay == 5 ? "selected" : "")>+5 days</option>
                                <option value="6" @(product?.PreparationDay == 6 ? "selected" : "")>+6 days</option>
                                <option value="7" @(product?.PreparationDay == 7 ? "selected" : "")>+7 days</option>
                            </select>
                        </div>
                    }
                    @if (prdType == 1 || prdType == 6 || prdType == 2)
                    {
                        <br class="clearfix" />
                        @* ─── Collection (legacy: div_collectionouter with icon — visible for types 1,6,2) ─── *@
                        <div id="div_collectionouter" class="form-group">
                            <label class="control-label">Collection</label>
                            <div class="clearfix"></div>
                            <div class="col-md-3">
                                <label class="checkbox-inline">
                                    <input type="checkbox" id="chkCollection" @(deliverySettings.IsCollectable ? "checked" : "") />
                                    <img src="https://cakerstreet1.s3.amazonaws.com/bakery_content/images/collections.png" alt="" />
                                    Collection
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Non-cake: SKU + Prep Day *@
                        <div class="form-group col-md-4 no-left-padding">
                            <label for="">SKU *</label>
                            <input type="text" id="txtSKU" class="form-control" maxlength="70" value="@(product?.ProductCode ?? "")" />
                        </div>
                    }

                    <div class="clearfix"></div>

                    @* ─── Delivery (legacy: div_deliveryouter — visible for types 1,6,2) ─── *@
                    @if (prdType == 1 || prdType == 6 || prdType == 2)
                    {
                        <br class="clearfix" />
                        <div id="div_deliveryouter" class="form-group">
                            <label class="control-label">Delivery</label>
                            <div class="clearfix"></div>
                            <div class="col-md-3">
                                <label class="checkbox-inline">
                                    <input type="checkbox" id="chkdelivery" @(deliverySettings.IsDeliverable ? "checked" : "") />
                                    <img src="https://cakerstreet1.s3.amazonaws.com/bakery_content/images/deliverynew.png" alt="" />
                                    Delivery
                                </label>
                            </div>
                            <div class="divdeliverytype" id="divdeliverytype">
                                <div class="col-md-9">
                                    <div id="divdeliverytype1">
                                        <div class="col-sm-2 raln">Upto</div>
                                        <div class="col-sm-2">
                                            <input type="text" id="txtdeliverymiles" class="form-control gray-input" maxlength="5"
                                                   placeholder="20" value="@(deliverySettings.DeliveryMiles > 0 ? deliverySettings.DeliveryMiles.ToString("0") : "0")" />
                                        </div>
                                        <div class="col-sm-7">
                                            Miles from @(ViewBag.BakeryPostcode ?? "bakery")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <div class="col-md-3">
                                <label class="checkbox-inline">
                                    <input type="checkbox" id="chkpostaldelivery" @(deliverySettings.IsPostalDelivery ? "checked" : "") />
                                    <img src="https://cakerstreet1.s3.amazonaws.com/bakery_content/images/deliverynew.png" alt="" />
                                    Postal Delivery
                                </label>
                            </div>
                        </div>
                    }

                    @* ─── Supplier section (legacy: dvSupplier — visible for stock types 2,4,5) ─── *@
                    @if (prdType >= 4 || prdType == 2)
                    {
                        <div id="dvSupplier" class="col-lg-12 col-md-12 col-sm-12 top-margin flush">
                            <div class="form-group col-sm-12 headertext bggrey">
                                <b>Supplier</b>
                            </div>
                            <div class="form-group">
                                <div id="div_supplier"></div>
                                <br clear="all" />
                                <div class="col-sm-12 form-group" style="margin-top: 10px;">
                                    <a id="ancShowAddSupplier" class="text-danger">+ Add Supplier</a>
                                </div>
                                <br clear="all" />
                                <div id="dvAddSupplier" class="col-sm-12 form-group" style="display: none;">
                                    <div class="form-group col-sm-4 no-left-padding">
                                        <input id="txtSearchSupplier" class="form-control" type="text" placeholder="Enter Keyword To Search" />
                                    </div>
                                    <div class="form-group col-sm-1 no-left-padding">Or</div>
                                    <div class="form-group col-sm-2 no-left-padding">
                                        <a id="ancShowNewSupplierPopUp" class="text-danger">Create New Supplier</a>
                                    </div>
                                    <div class="form-group col-sm-1 no-left-padding">
                                        <a id="ancHideAddSupplier" class="text-danger">X</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <br class="clearfix" />

                    @* ─── Wholesale Price (stock types) ─── *@
                    @if (prdType >= 4 || prdType == 2)
                    {
                        var wsPrice = (decimal)(ViewBag.WholesalePrice ?? 0m);
                        var prdQty = (int)(ViewBag.ProductQuantity ?? 0);
                        var pkgUnitId = (int)(ViewBag.PackagingUnitId ?? 0);
                        var pkgUnits = ViewBag.PackagingUnits as List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>
                            ?? new List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>();

                        <div id="dvWSPrice" class="form-group col-md-3 no-left-padding">
                            <label>Wholesale Price *</label>
                            <div class="divinputprice">
                                £<input type="text" id="txtWSPrice" class="form-control" value="@(wsPrice > 0 ? wsPrice.ToString("0.00") : "")" />
                            </div>
                        </div>
                    }

                    @* ─── Retail / Sale Price (visible for all, hidden for cake types via style) ─── *@
                    <div id="divPriceouter" class="form-group col-md-3 no-left-padding" @(prdType == 1 || prdType == 6 ? "style=display:none;" : "")>
                        <label>Retail | Sale Price *</label>
                        <div class="divinputprice">
                            £<input type="text" id="txtPrice" class="form-control" value="@(product?.Price.ToString("0.00") ?? "0.00")" />
                        </div>
                    </div>

                    @* ─── Quantity (type 2 only) ─── *@
                    @if (prdType == 2)
                    {
                        var prdQty2 = (int)(ViewBag.ProductQuantity ?? 0);
                        <div id="divQuantityeouter" class="form-group col-md-3 no-left-padding">
                            <label>Quantity *</label>
                            <input type="text" id="txtQuantity" placeholder="e.g. 12" class="form-control" value="@(prdQty2 > 0 ? prdQty2.ToString() : "")" />
                        </div>
                    }

                    @* ─── Packaging Unit (stock types) ─── *@
                    @if (prdType >= 4 || prdType == 2)
                    {
                        var pkgUnitId2 = (int)(ViewBag.PackagingUnitId ?? 0);
                        var pkgUnits2 = ViewBag.PackagingUnits as List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>
                            ?? new List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>();
                        <div id="divUnitTypeouter" class="form-group col-md-3 no-left-padding">
                            <label>Packaging Unit *</label>
                            <select id="drpPackagingUnit" class="form-control">
                                <option value="0">--Select Unit--</option>
                                @foreach (var u in pkgUnits2)
                                {
                                    <option value="@u.Id" @(pkgUnitId2 == u.Id ? "selected" : "")>@u.Title</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="clearfix"></div>

                    @* ─── Accessory Type + Bakery Themes (type 2 only) ─── *@
                    @if (prdType == 2)
                    {
                        var accTypes = ViewBag.AccessoryTypes as List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>
                            ?? new List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>();
                        var accTypeId = (int)(ViewBag.AccessoryTypeId ?? 0);
                        var themes = ViewBag.BakeryThemes as List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>
                            ?? new List<CakerStreet.Business.Controllers.AddNewCakeController.DropdownItem>();

                        <div id="divAccesorydrpouter" class="form-group col-md-4 no-left-padding">
                            <label>Accessory Type *</label>
                            <select id="drpAccesorytype" class="form-control">
                                <option value="-1">--Select Type--</option>
                                @foreach (var at in accTypes)
                                {
                                    <option value="@at.Id" @(accTypeId == at.Id ? "selected" : "")>@at.Title</option>
                                }
                            </select>
                        </div>
                        <div class="clearfix"></div>
                        <div id="divAccesorytheme" class="form-group col-md-12 no-left-padding">
                            <label>Bakery Theme(s)</label>
                            <div class="clearfix"></div>
                            <div id="dvThemes">
                                @foreach (var theme in themes)
                                {
                                    <label class="checkbox-inline">
