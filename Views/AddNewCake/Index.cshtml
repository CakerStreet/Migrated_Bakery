        supplierId: parseInt($('#ddlSupplier').val()) || 0,
        locationId: parseInt($('#ddlStockLocation').val()) || 0,
        quantity: parseInt($('#txtSupQty').val()) || 0,
        purchaseOrder: $('#txtPurchaseOrder').val(),
        poDate: $('#txtPODate').val(),
        orderReceived: $('#txtOrderReceived').val(),
        orDate: $('#txtORDate').val()
    };
    $.ajax({
        url: '/addnewcake/savequantity', type: 'POST', contentType: 'application/json',
        data: JSON.stringify(data),
        success: function (r) {
            if (r.success) {
                showMessage('Quantity saved.', true);
                $('#dvManageQtyModal').modal('hide');
                if (r.totalQty !== undefined) { $('#spQty').text(r.totalQty); }
            } else { showMessage(r.message || 'Save failed.', false); }
        },
        error: function () { showMessage('Save error.', false); }
    });
}
</script>
}
