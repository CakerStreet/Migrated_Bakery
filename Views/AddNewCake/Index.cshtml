// ─── Update all flavour children size-price dropdowns ─────────────────────────
function updateflavourSizePrice() {
    $('.div_flavourchildbox').each(function () {
        var $child = $(this);
        var $priceDiv = $child.find('.div_FlavorsizePrice');
        if ($priceDiv.length === 0) return;
        var existing = {};
        $priceDiv.find('.divrow').each(function () {
            existing[$(this).data('for')] = {
                checked: $(this).find('.chkbox_flavoursizeprice').is(':checked'),
                price: $(this).find('.inputPrice').val() || '0'
            };
        });
        $priceDiv.empty();
        $('#Div_sizelitingouter .divsizebox').each(function () {
            var sGuid = $(this).data('tid');
            var sTitle = $.trim($(this).find('.csssizetitle').val());
            if (!sTitle) return;
            var chkId = guid();
            var prev = existing[sGuid] || { checked: true, price: '0' };
            var row = '<div class="divrow" data-for="' + sGuid + '"><ul>';
            row += '<li class="lichk"><input type="checkbox" ' + (prev.checked ? 'checked="checked"' : '') + ' class="chkbox_flavoursizeprice checkbox" id="' + chkId + '" />';
            row += '<label class="lblForcheck" for="' + chkId + '">' + sTitle + '</label></li>';
            row += '<li class="liprice">+£<input type="text" class="form-control gray-input inputPrice" placeholder="0.00" value="' + prev.price + '" /></li>';
            row += '</ul></div>';
            $priceDiv.append(row);
        });
    });
}

function removeflavourSizePrice(sizeGuid) {
    $('.div_FlavorsizePrice .divrow[data-for="' + sizeGuid + '"]').remove();
}

