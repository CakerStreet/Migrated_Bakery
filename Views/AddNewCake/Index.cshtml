@section FooterScripts {
<script type="text/javascript">
$(document).ready(function () {
    $('#chkdelivery').on('click', function () { ManageDeliveryVisibility(); });
    ManageDeliveryVisibility();

    // Initialize CKEditor on Short Description and Large Description (matches legacy behavior)
    if (typeof CKEDITOR !== 'undefined') {
        CKEDITOR.replace('txtDescription', {
            removeDialogTabs: 'link:upload;image:upload',
            height: 55
        });
        CKEDITOR.replace('txtlrgDesc', {
            removeDialogTabs: 'link:upload;image:upload',
            height: 100
        });
    }

    // Copy Description feature (legacy ancCopyDesc)
    $("body").on("click", "#ancCopyDesc", function () {
        var descText = (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['txtlrgDesc']) ? CKEDITOR.instances['txtlrgDesc'].getData() : $("#txtlrgDesc").val();
        if (navigator.clipboard) {
            navigator.clipboard.writeText(descText).then(function() {
                showMessage('Description copied to clipboard.', true);
            });
        } else {
            $("#txtlrgDesc").select();
            document.execCommand('copy');
            showMessage('Description copied to clipboard.', true);
        }
    });

    // Initialize date pickers if jQuery UI is available
    if ($.fn.datepicker) {
        $('#txtPODate, #txtORDate').datepicker({ dateFormat: 'dd/mm/yy' });
    }
});

function ManageDeliveryVisibility() {
    $("#txtdeliverymiles").prop("disabled", !$('#chkdelivery').is(':checked'));
    if ($('#chkdelivery').is(':disabled')) { $("#txtdeliverymiles").prop("disabled", true); }
    if ($.trim($("#txtdeliverymiles").val()) == '') { $("#txtdeliverymiles").val('0'); }
}

function showMessage(msg, ok) {
    var $d = $('#divMessage');
    if ($d.length === 0) { $('body').prepend('<div id="divMessage" class="alert" style="position:fixed;top:10px;right:10px;z-index:9999;"></div>'); $d = $('#divMessage'); }
    $d.removeClass('alert-danger alert-success').addClass(ok ? 'alert alert-success' : 'alert alert-danger').text(msg).fadeIn();
    setTimeout(function () { $d.fadeOut(); }, 4000);
}

function saveProduct() {
    var name = $.trim($('#txtPrdTitle').val());
    if (!name) { alert('Product name is required.'); return; }
    var categoryId = parseInt($('#hfCatIDs').val()) || 0;
    var prdType = parseInt($('#hfPrdtype').val()) || 1;
    var data = {
        productId: parseInt($('#hfPrdID').val()) || 0,
        productName: name,
        shortDescription: (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['txtDescription']) ? CKEDITOR.instances['txtDescription'].getData() : $('#txtDescription').val(),
        longDescription: (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['txtlrgDesc']) ? CKEDITOR.instances['txtlrgDesc'].getData() : $('#txtlrgDesc').val(),
        productCode: $('#txtSKU').val() || '',
        productType: prdType,
        isActive: true,
        price: parseFloat($('#txtPrice').val()) || 0,
        preparationDay: parseInt($('#drpPreparationday').val()) || 0,
        categoryId: categoryId,
        categoryIds: [],
        cakeShapeId: parseInt($('#drpcakeshape').val()) || 0,
        cakeTypeId: parseInt($('#drpCaketype').val()) || 0,
        isCollectable: $('#chkCollection').is(':checked'),
        isDeliverable: $('#chkdelivery').is(':checked'),
        isPostalDelivery: $('#chkpostaldelivery').is(':checked'),
        deliveryMiles: parseFloat($('#txtdeliverymiles').val()) || 0
    };
    $.ajax({
        url: '/addnewcake/savebasic', type: 'POST', contentType: 'application/json',
        data: JSON.stringify(data),
        success: function (r) {
            if (r.success) { showMessage(r.message, true); if (r.productId && data.productId === 0) { setTimeout(function () { window.location.href = '/addnewcake?prdID=' + r.productId; }, 1500); } }
            else { showMessage(r.message || 'Save failed.', false); }
        },
        error: function () { showMessage('An error occurred.', false); }
    });
}

// ─── Cascading Category Dropdowns ─────────────────────────────────────────────
$('.div_catdrps_ListingOuter').on('change', 'select.form-control', function () {
    showCategoriesbyCatID($(this).val(), parseInt($(this).attr('data-tid').toString()));
});

function showCategoriesbyCatID(catId, intlevel) {
    $('#hfCatIDs').val('0');
    // Remove all selects with data-tid > current level
    $('.div_catdrps_ListingOuter select.form-control').each(function () {
        if (parseInt($(this).attr('data-tid').toString()) > intlevel) { $(this).remove(); }
    });
    // AJAX call to get child categories
    $.ajax({
        type: 'POST', url: '/addnewcake/getcategories',
        data: JSON.stringify({ catId: catId, intLevel: intlevel }),
        contentType: 'application/json; charset=utf-8', dataType: 'json',
        success: function (msg) {
            if (msg.dataId == 1) {
                // Children exist - append new select
                $('.div_catdrps_ListingOuter').append(msg.dataStr);
            } else {
                // Leaf category - store ID
                $('#hfCatIDs').val(catId == '-1' ? '0' : catId);
            }
        }
    });
}

// Generate GUID (legacy: guid())
function guid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    }).replace(/-/g, '');
}

// ─── Add Size Box (legacy: addnewsize_clicked) ────────────────────────────────
$(document).on('click', '.btn_addsize', function () {
    var sizeTitle = $.trim($('#txtaddnewsize_template').val());
    if (!sizeTitle) { alert('Enter a size name first.'); return; }
    // Check for duplicate
    var isDuplicate = false;
    $('#Div_sizelitingouter .csssizetitle').each(function() {
        if ($.trim($(this).val()).toLowerCase() === sizeTitle.toLowerCase()) { isDuplicate = true; return false; }
    });
    if (isDuplicate) { alert('Size already exists.'); return; }
    var newGuid = guid();
    var html = '<div data-tid="' + newGuid + '" class="col-md-6 divsizebox">' +
        '<div class="col-sm-8 gray-bg"><label class="checkbox-inline">' +
        '<input type="checkbox" checked="checked" class="chkbox" />' +
        '<input type="text" value="' + sizeTitle + '" data-text="' + sizeTitle + '" class="form-control gray-input csssizetitle" />' +
        '</label>' +
        '<div class="div_portionouter"><span>1 - 10</span><div class="selectdrop"><b class="caret"></b></div>' +
        '<div class="div_sizeportion"><div class="divrow">' +
        '<ul><li><label>Min. Portion</label></li><li class="liprice"><input type="text" value="1" placeholder="1" class="form-control gray-input inputminportion" /></li></ul>' +
        '<ul><li><label>Max. Portion</label></li><li class="liprice"><input type="text" value="10" placeholder="10" class="form-control gray-input inputmaxportion" /></li></ul>' +
        '</div></div></div></div>' +
        '<div class="col-sm-4">£<input type="text" value="0" placeholder="0.00" class="form-control gray-input inputprice" /></div>' +
        '<small class="upward"><a>&nbsp;</a></small><small class="remouter"><a class="text-danger">X</a></small>' +
        '</div>';
    $('#Div_sizelitingouter').append(html);
    $('#txtaddnewsize_template').val('');
    updateflavourSizePrice();
});

// ─── Size box portion hover toggle ────────────────────────────────────────────
$(document).on('mouseenter', '.div_portionouter', function () {
    $(this).find('.div_sizeportion').show();
}).on('mouseleave', '.div_portionouter', function () {
    $(this).find('.div_sizeportion').hide();
});

// ─── Update portion span text when min/max changes ────────────────────────────
$(document).on('change', '.inputminportion, .inputmaxportion', function () {
    var $row = $(this).closest('.div_portionouter');
    var min = $row.find('.inputminportion').val() || '1';
    var max = $row.find('.inputmaxportion').val() || '10';
