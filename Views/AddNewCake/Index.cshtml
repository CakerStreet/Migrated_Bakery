// ─── Specification Template Dropdown Handler ──────────────────────────────────
$('#drpShippingTemplate').change(function () {
    $('.updateshippingtemplate').hide();
    var templateId = $(this).val();
    if (templateId == '0') {
        $('.saveshippingtemplate').show();
        return;
    }
    $.ajax({
        type: 'POST', url: '/addnewcake/gettemplatedetails',
        data: JSON.stringify({ templateId: templateId }),
        contentType: 'application/json; charset=utf-8', dataType: 'json',
        success: function (msg) {
            if (msg.dataId == 1) {
                // Toggle save/update buttons (legacy behavior)
                $('.saveshippingtemplate').hide();
                $('.updateshippingtemplate').show();

                // Auto-fill form fields from template settings
                if (msg.shapeId > 0) $('#drpcakeshape').val(msg.shapeId);
                if (msg.typeId > 0) $('#drpCaketype').val(msg.typeId);
                if (msg.preparationDay > 0) $('#drpPreparationday').val(msg.preparationDay);
                $('#chkCollection').prop('checked', msg.isCollection);
                $('#chkdelivery').prop('checked', msg.isDelivery);
                $('#chkpostaldelivery').prop('checked', msg.isPostal);
                if (msg.miles) $('#txtdeliverymiles').val(msg.miles);

                // Load sizes from template
                if (msg.sizes && msg.sizes.length > 0) {
                    $('#Div_sizelitingouter').empty();
                    $.each(msg.sizes, function(i, s) {
                        var newGuid = guid();
                        var sHtml = '<div data-tid="' + newGuid + '" class="col-md-6 divsizebox">' +
                            '<div class="col-sm-8 gray-bg"><label class="checkbox-inline">' +
                            '<input type="checkbox" checked="checked" class="chkbox" />' +
                            '<input type="text" value="' + s.sizeTitle + '" data-text="' + s.sizeTitle + '" class="form-control gray-input csssizetitle" />' +
                            '</label><div class="div_portionouter"><span>' + (s.minPortion||1) + ' - ' + (s.maxPortion||10) + '</span><div class="selectdrop"><b class="caret"></b></div>' +
                            '<div class="div_sizeportion"><div class="divrow">' +
                            '<ul><li><label>Min. Portion</label></li><li class="liprice"><input type="text" value="' + (s.minPortion||1) + '" placeholder="1" class="form-control gray-input inputminportion" /></li></ul>' +
                            '<ul><li><label>Max. Portion</label></li><li class="liprice"><input type="text" value="' + (s.maxPortion||10) + '" placeholder="10" class="form-control gray-input inputmaxportion" /></li></ul>' +
                            '</div></div></div></div>' +
                            '<div class="col-sm-4">£<input type="text" value="' + (s.price||0) + '" placeholder="0.00" class="form-control gray-input inputprice" /></div>' +
                            '<small class="upward"' + (i == 0 ? ' style="display:none;"' : '') + '><a>&nbsp;</a></small><small class="remouter"><a class="text-danger">X</a></small>' +
                            '</div>';
                        $('#Div_sizelitingouter').append(sHtml);
                    });
                    updateflavourSizePrice();
                }

                // Load flavours from template
                if (msg.flavours && msg.flavours.length > 0) {
                    $('#Div_Flavourlistingouter').empty();
                    $.each(msg.flavours, function(fi, flv) {
                        var parentGuid = guid();
                        var viewType = flv.viewType || 1;
                        var fHtml = '<div class="div_flavourmainouter" data-tid="' + parentGuid + '" data-typeid="' + viewType + '">';
                        fHtml += '<div class="col-md-12 div_flavourParent_outer">';
                        fHtml += '<div class="col-sm-8 gray-bg"><label class="checkbox-inline">';
                        fHtml += '<input type="checkbox" checked="checked" class="chkbox_flavour" />';
                        fHtml += '<input type="text" value="' + flv.title + '" class="form-control white-input" /></label>';
                        // Selection View controls for type 6
                        if (viewType == 6) {
                            fHtml += '<div class="div_SelectionMain div_Mandatory">&nbsp;<div class="selectdrop"><b class="caret"></b></div>';
                            fHtml += '<div class="div_SelectionExclist"><div class="divrow"><ul><li class="lichk"><input type="checkbox" class="chkMandatory checkbox" /><label class="lblForcheck">Mandatory</label></li></ul></div>';
                            fHtml += '<div class="divrow"><ul><li class="lichk"><input type="checkbox" class="chkSelectSingle checkbox" /><label class="lblForcheck">Single Selection</label></li></ul></div></div></div>';
                        }
                        fHtml += '<small class="upward"><a>&nbsp;</a></small><small class="remouter"><a class="text-danger">X</a></small>';
                        fHtml += '</div></div>';
                        if (viewType == 1 || viewType == 6 || viewType == 7) {
                            fHtml += '<div class="col-md-8"><p><small>Please select all the values which are applicable.</small></p></div>';
                        }
                        fHtml += '<div class="div_flavourchild_outer">';
                        // Add children
                        if (flv.children && flv.children.length > 0) {
                            $.each(flv.children, function(ci, child) {
                                var childGuid = guid();
                                fHtml += '<div class="col-md-5 div_flavourchildbox" data-tid="' + childGuid + '">';
                                fHtml += '<div class="col-sm-8 gray-bg"><label class="checkbox-inline">';
                                fHtml += '<input type="checkbox" checked="checked" class="chkbox_flavour" />';
                                fHtml += '<input type="text" value="' + child.title + '" data-text="' + child.title + '" class="form-control gray-input input_flavourchild" /></label></div>';
                                fHtml += '<div class="col-sm-4">' + buildFlavourSizePriceHtml(childGuid) + '</div>';
                                fHtml += '<small class="upward"><a>&nbsp;</a></small><small class="remouter"><a class="text-danger">X</a></small>';
                                fHtml += '</div>';
                            });
                        }
                        fHtml += '</div>';
                        // Add option button for types 1, 6
                        if (viewType == 1 || viewType == 6) {
                            fHtml += '<div class="col-md-5 addbutouter"><div class="col-sm-8 no-left-padding no-right-padding">';
                            fHtml += '<input type="text" class="form-control gray-input addoption_input" />';
                            fHtml += '</div><div class="col-sm-4"><button class="btn black-rounded addoption_btn" type="button">+</button></div></div>';
                        }
                        fHtml += '</div>';
                        $('#Div_Flavourlistingouter').append(fHtml);
                    });
                    if (typeof updateflavourExclude === 'function') updateflavourExclude();
                }
            } else {
                alert(msg.message || 'Template not found.');
                $('#drpShippingTemplate').val('0');
            }
        },
        error: function (x) { alert('Error loading template: ' + x.responseText); }
    });
});

// ─── Save Template (matches legacy: saveshippingtemplate click) ────────────────
$(document).on('click', '#saveshippingtemplate', function () {
    saveSpecsAndSizes();
});
$(document).on('click', '#updateshippingtemplate', function () {
    saveSpecsAndSizes();
});

function saveSpecsAndSizes() {
    var pid = parseInt($('#hfPrdID').val()) || 0;
    if (pid === 0) { alert('Save the product first before adding specs/sizes.'); return; }
    var specData = { productId: pid, ingredients: $('#txtIngredients').val(), allergens: $('#txtAllergens').val(), advice: $('#txtAdvice').val(), deliveryDetails: $('#txtdeliverydetail').val(), storage: $('#txtStorage').val() };
    var sizes = [];
    $('#Div_sizelitingouter .divsizebox').each(function () {
        var $box = $(this);
        if (!$box.find('.chkbox').is(':checked')) return;
        var title = $.trim($box.find('.csssizetitle').val());
        if (!title) return;
        sizes.push({
            sizeTitle: title,
            price: parseFloat($box.find('.inputprice').val()) || 0,
            minPortion: parseInt($box.find('.inputminportion').val()) || 0,
            maxPortion: parseInt($box.find('.inputmaxportion').val()) || 0
        });
    });
    var sizeData = { productId: pid, typeId: parseInt($('#drpCaketype').val()) || 0, shapeId: parseInt($('#drpcakeshape').val()) || 0, sizes: sizes };
    $.ajax({ url: '/addnewcake/savespec', type: 'POST', contentType: 'application/json', data: JSON.stringify(specData),
        success: function (r1) { if (!r1.success) { showMessage('Spec save failed: ' + r1.message, false); return; } if (sizes.length === 0) { showMessage('Specifications saved.', true); return; }
            $.ajax({ url: '/addnewcake/savesizes', type: 'POST', contentType: 'application/json', data: JSON.stringify(sizeData),
                success: function (r2) { showMessage(r2.success ? 'Specifications and sizes saved.' : 'Size save failed: ' + r2.message, r2.success); },
                error: function () { showMessage('Size save error.', false); } }); },
        error: function () { showMessage('Spec save error.', false); } });
}

