// File change handler — upload to server
$('#ul_uploadImages').on('change', '.addPrdImg input[type="file"]', function () {
    var $prdImgbox = $(this).closest('.prdImgbox');
    var input = this;
    var file = input.files[0];
    if (!file) return;
    var pid = parseInt($('#hfPrdID').val()) || 0;
    if (pid === 0) { alert('Save the product first before uploading images.'); return; }
    var $imgBoxOuter = $(this).closest('.prdImgbox_outer');
    var imageIndex = $imgBoxOuter.data('id') || 1;
    var formData = new FormData();
    formData.append('file', file);
    formData.append('productId', pid);
    formData.append('imageIndex', imageIndex);
    // Show loading
    $prdImgbox.find('.loading').show();
    $.ajax({
        url: '/addnewcake/uploadimage', type: 'POST',
        data: formData, processData: false, contentType: false,
        success: function (r) {
            $prdImgbox.find('.loading').hide();
            if (r.success) {
                showMessage('Image uploaded.', true);
                $prdImgbox.find('.PrdImg').css({'background-image': "url('" + r.imageUrl + "')", 'display': 'block'});
                $prdImgbox.find('.addPrdImg').hide();
                $prdImgbox.find('.edit').show();
                $prdImgbox.find('.remove').show();
                $prdImgbox.find('.spn_radioouter').show();
                $prdImgbox.attr('data-tid', r.imagePath || '');
                updateImageval();
            } else { showMessage(r.message || 'Upload failed.', false); }
        },
        error: function () { $prdImgbox.find('.loading').hide(); showMessage('Upload error.', false); }
    });
});

// Edit button — show file input again
$('#ul_uploadImages').on('click', '.prdImgbox .edit', function () {
    var $prdImgbox = $(this).closest('.prdImgbox');
    $prdImgbox.find('.PrdImg').css('display', 'none');
    $prdImgbox.find('.addPrdImg').show();
    $(this).hide();
    $prdImgbox.find('.remove').hide();
});

// Remove button — reset image
$('#ul_uploadImages').on('click', '.prdImgbox .remove', function () {
    var $prdImgbox = $(this).closest('.prdImgbox');
    $prdImgbox.find('.PrdImg').css({'background-image': '', 'display': 'none'});
    $prdImgbox.find('.addPrdImg').show();
    $prdImgbox.find('.edit').hide();
    $(this).hide();
    $prdImgbox.find('.spn_radioouter').hide();
    $prdImgbox.attr('data-tid', '0');
    // Reset file input
    var $fileInput = $prdImgbox.find('.addPrdImg input[type="file"]');
    $fileInput.val('');
    updateImageval();
});

// Update hidden image val field
function updateImageval() {
    var imgs = [];
    $('#ul_uploadImages .prdImgbox_outer.imgboxouter').each(function () {
        var tid = $(this).find('.prdImgbox').attr('data-tid');
        if (tid && tid !== '0') imgs.push(tid);
    });
    $('#hdn_Product_Images').val(imgs.join(','));
}


