@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cdnBase = ViewBag.CdnBase as string ?? "https://cakerstreet1.s3.amazonaws.com/";
    var categories = ViewBag.Categories as List<CakerStreet.Business.Services.ChecklistCategoryItem> ?? new();
    var staffList = ViewBag.StaffList as List<CakerStreet.Business.Services.BakeryStaffItem> ?? new();
    var categoryFiles = ViewBag.CategoryFiles as Dictionary<long, List<CakerStreet.Business.Services.UploadedFileItem>> ?? new();
    var editItem = ViewBag.EditItem as CakerStreet.Business.Services.UploadedFileItem;
    var successMsg = ViewBag.SuccessMessage as string;
    var userType = Context.Items["BakeryUserType"]?.ToString() ?? "";
}

@section Head {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <style type="text/css">
        .inventoryWrapper .innerhead {
            display: table;
            width: 100%;
        }
        .normallink, .normallink:hover, .normallink:focus {
            font-size: 14px;
            text-decoration: underline;
            color: #fff;
        }
        .table-files {
            margin-top: 5px;
            font-size: 12px;
            width: 100%;
        }
        .table-files td {
            padding: 6px !important;
        }
        .glyphicon {
            margin: 0 4px;
        }
        .upload-section {
            background-color: #fafafa;
            padding: 10px;
            border: 1px solid #eee;
            border-radius: 4px;
        }
        .action-link {
            color: #337ab7;
            text-decoration: none;
            cursor: pointer;
        }
        .action-link:hover {
            text-decoration: underline;
        }
        .delete-btn {
            background: none;
            border: none;
            padding: 0;
            color: #d9534f;
            cursor: pointer;
        }
    </style>
}

<div class="row top-margin-less bakerypagecss">
    <div class="col-md-12">
        <div class="panel panel-default no-out-border">
            <div class="col-lg-12 col-md-12 col-sm-12 top-margin">
                <div class="orderWrappernew">
                    <div class="innerhead">
                        <div class="col-md-12" style="padding-left: 0; padding-right: 0;">
                            <h2>
                                Manage Other Checklists
                                <a href="/dailydairychecklists" class="pull-right normallink">Back</a>
                            </h2>
                        </div>
                    </div>

                    <div class="col-md-12 panel-collapse collapse in" id="collapse4" aria-expanded="true" style="padding-left:0; padding-right:0; margin-top: 15px;">
                        
                        @if (!string.IsNullOrEmpty(successMsg))
                        {
                            <div class="alert alert-success">
                                @successMsg
                            </div>
                        }

                        <div id="dvCleaningChecklist" class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr class="active">
                                        <th style="width: 25%;">Checklist Name</th>
                                        <th style="width: 45%;">Uploaded Files</th>
                                        <th style="width: 30%;">Upload Check</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in categories)
                                    {
                                        var files = categoryFiles.TryGetValue(cat.ChecklistCatId, out var fileList) ? fileList : new();
                                        var isEditingThisCat = editItem != null && editItem.CatId == cat.ChecklistCatId;
                                        
                                        var valUploadedId = isEditingThisCat ? editItem.ChecklistFileUploadedId : 0;
                                        var valTitle = isEditingThisCat ? editItem.FileTitle : "";
                                        var valDateStr = isEditingThisCat ? editItem.FileDate.ToString("dd/MM/yyyy") : DateTime.Today.ToString("dd/MM/yyyy");
                                        var valStaffId = isEditingThisCat ? editItem.StaffId : 0;
                                        var valRemarks = isEditingThisCat ? editItem.Remarks : "";

                                        <tr>
                                            <td style="vertical-align: top;">
                                                <strong>@cat.Title</strong>
                                                @if (!string.IsNullOrEmpty(cat.File))
                                                {
                                                    <br />
                                                    <a href="https://cakerstreet1.s3.amazonaws.com/upload/haccp/template/@cat.File" class="action-link" target="_blank">Download Sample</a>
                                                }
                                            </td>
                                            <td style="vertical-align: top;">
                                                @if (files.Count == 0)
                                                {
                                                    <span class="text-muted">No files uploaded.</span>
                                                }
                                                else
                                                {
                                                    <table class="table table-bordered table-files">
                                                        <tbody>
                                                            @foreach (var file in files)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @file.FileTitle (@file.FileDate.ToString("dd/MM/yyyy"))
                                                                        
                                                                        @if (!string.IsNullOrEmpty(file.File))
                                                                        {
                                                                            <a href="https://cakerstreet1.s3.amazonaws.com/upload/haccp/docs/@file.File" target="_blank" title="Download File">
                                                                                <span class="glyphicon glyphicon-download-alt"></span>
                                                                            </a>
                                                                        }

                                                                        @if (userType != "3")
                                                                        {
                                                                            <!-- Delete Form -->
                                                                            <form action="/addupduploadchecks/delete/@file.ChecklistFileUploadedId" method="post" style="display:inline;" class="pull-right" onsubmit="return confirm('Are you sure you want to delete this file?');">
                                                                                <button type="submit" class="delete-btn" title="Delete">
                                                                                    <span class="glyphicon glyphicon-trash"></span>
                                                                                </button>
                                                                            </form>

                                                                            <!-- Edit Link -->
                                                                            <a href="/addupduploadchecks?editId=@file.ChecklistFileUploadedId" class="pull-right" title="Edit" style="margin-right: 10px;">
                                                                                <span class="glyphicon glyphicon-edit"></span>
                                                                            </a>
                                                                        }
                                                                        
                                                                        @if (!string.IsNullOrEmpty(file.Remarks))
                                                                        {
                                                                            <br /><small class="text-muted">Remarks: @file.Remarks</small>
                                                                        }
                                                                        <br /><small class="text-muted">Uploaded by: @file.UploadByCustName | Staff: @file.StaffName</small>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            </td>
                                            <td style="vertical-align: top;">
                                                <form action="/addupduploadchecks/submit" method="post" enctype="multipart/form-data" class="upload-section">
                                                    <input type="hidden" name="checklistFileUploadedId" value="@valUploadedId" />
                                                    <input type="hidden" name="checklistCatId" value="@cat.ChecklistCatId" />

                                                    <div class="form-group">
                                                        <label>Browse Document: <span class="text-danger">*</span></label>
                                                        <input type="file" name="fileUpload" class="form-control input-sm" @(valUploadedId == 0 ? "required" : "") />
                                                        @if (valUploadedId > 0)
                                                        {
                                                            <span class="small text-muted">Leave empty to keep existing document.</span>
                                                        }
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Document Title:</label>
                                                        <input type="text" name="fileTitle" value="@valTitle" placeholder="Document Title" class="form-control input-sm" />
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Document Date: <span class="text-danger">*</span></label>
                                                        <input type="text" name="docDateStr" value="@valDateStr" placeholder="dd/MM/yyyy" class="form-control input-sm" required />
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Choose Staff:</label>
                                                        <select name="staffId" class="form-control input-sm">
                                                            <option value="0">--Select--</option>
                                                            @foreach (var staff in staffList)
                                                            {
                                                                var isSelected = valStaffId == staff.Id ? "selected" : "";
                                                                <option value="@staff.Id" @isSelected>@staff.Name</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Remarks:</label>
                                                        <textarea name="remarks" placeholder="Remarks" class="form-control input-sm" style="height: 60px;">@valRemarks</textarea>
                                                    </div>

                                                    <button type="submit" class="btn btn-black btn-sm square">Submit</button>
                                                    @if (valUploadedId > 0)
                                                    {
                                                        <a href="/addupduploadchecks" class="btn btn-default btn-sm" style="margin-left: 5px;">Cancel</a>
                                                    }
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
<script type="text/javascript">
    $(document).ready(function() {
        $("input[name='docDateStr']").datepicker({
            dateFormat: "dd/mm/yy"
        });
    });
</script>
