@{
    ViewData["Title"] = "Food Standards";
}

@section Head {
    <style type="text/css">
        .div_QuestionMain_outer {
            display: table;
            margin: 0px auto 20px;
            width: 100%;
        }
        ol, ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }
        .div_QuestionMain > ul.UL_QuestionMain {
            display: table;
            width: 100%;
        }
        .div_QuestionMain_outer li {
            line-height: 30px;
        }
        .div_QuestionMain > ul.UL_QuestionMain li {
            float: left;
            line-height: 20px;
            font-size: 14px;
            font-weight: bold;
            width: 100%;
            position: relative;
            padding: 5px 0 5px 20px;
        }
        ul.UL_QuestionMain li span {
            position: absolute;
            left: 0;
            top: 5px;
        }
        .inventoryWrapper .innerhead {
            display: table;
            width: 100%;
        }
    </style>
}

<div class="row top-margin"></div>
<div class="clearfix"></div>

<div class="inventoryWrapper">
    <div class="innerhead">
        <div class="col-md-12">
            <h2 style="display: inline-block;">Food Standards</h2>
        </div>
    </div>
    <div class="col-lg-12 padding-top-mobile">
        <div class="col-md-12 col-xs-12 text-left no-left-padding no-right-padding">
            <div class="div_QuestionMain">
                <ul class="UL_QuestionMain">
                    <li>
                        <span>1.</span><a href="/course/food-allergen-awareness">Food Allergen Awareness</a>
                    </li>
                    <li>
                        <span>2.</span><a href="/haccp">HACCP</a>
                    </li>
                    <li>
                        <span>3.</span><a href="/managestaffcerificates">Staff Certificates</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
