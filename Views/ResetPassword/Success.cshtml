@{
    Layout = null;
    var cdnBase = "https://cakerstreet1.s3.amazonaws.com/";
    var successMessage = ViewBag.SuccessMessage as string ?? "Your password has been reset successfully.";
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Caker Street :: Success</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="@(cdnBase)bakery_content/img/favicon.ico?version=1.1" type="image/png" />
    <link href="@(cdnBase)bakery_content/bakery_content/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .loginPan {
            margin-top: 80px;
        }
        #footer { 
            background-color: #eee; 
            height: 60px; 
            bottom: 0; 
            width: 100%; 
            position: fixed; 
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-4 col-md-offset-4">
                <div class="panel panel-default loginPan text-center">
                    <div class="panel-body" style="padding: 30px;">
                        <span class="glyphicon glyphicon-ok-sign text-success" style="font-size: 48px; margin-bottom: 15px;"></span>
                        <h3>Password Reset Success</h3>
                        <p style="margin: 15px 0 25px 0;">@successMessage</p>
                        <a href="/businesslogin" class="btn btn-danger btn-block">Go to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="footer">
        <div class="container">
            <p class="text-muted text-center">Copyright &copy; Stioc Pro Ltd. All Rights Reserved.</p>
        </div>
    </div>
</body>
</html>
