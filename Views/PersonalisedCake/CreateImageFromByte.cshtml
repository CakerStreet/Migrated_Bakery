@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Convert Bytes To Image URL";
}

<div class="row">
    <div id="dvCategory" class="col-lg-12 col-md-12 col-sm-12 top-margin">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-7">
                    <h2>Convert Bytes To Image URL</h2>
                </div>
                <div class="col-md-5">
                </div>
            </div>

            <div class="col-sm-12" style="margin-top: 15px;">
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <form method="post" action="/createimagefrombyte">
                    @Html.AntiForgeryToken()
                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-12 headertext">
                                <p>
                                    <b>Enter Byte String</b>
                                </p>
                            </div>
                            <div class="col-sm-12">
                                <textarea name="txtByte" class="form-control" style="height: 200px;">@ViewBag.ByteString</textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12" id="divsaveonly_category">
                                <button type="submit" class="saveonly_category saveonly btn btn-danger btn-sm">Submit</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12 headertext">
                                <p>
                                    <b>Get Image URL</b>
                                </p>
                            </div>
                            <div class="col-sm-12">
                                <input type="text" readonly name="txtURL" class="form-control" value="@ViewBag.ImageUrl" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
