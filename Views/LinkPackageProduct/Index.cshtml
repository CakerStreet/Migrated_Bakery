@using CakerStreet.Business.Controllers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var templates = ViewBag.Templates as List<LinkPackageProductController.TemplateItem> ?? new();
    var sizes = ViewBag.Sizes as List<LinkPackageProductController.SizeItem> ?? new();
    var linkedItems = ViewBag.LinkedItems as List<LinkPackageProductController.LinkedProductItem> ?? new();
    var selectedTemplateId = ViewBag.SelectedTemplateId as long? ?? 0;
    var selectedSizeId = ViewBag.SelectedSizeId as int? ?? 0;
    var successMsg = ViewBag.SuccessMsg as string;
    var errorMsg = ViewBag.ErrorMsg as string;
    var cdnBase = ViewBag.CdnBase as string ?? "";
}

@section head {
    <link href="/css/sellcss.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" rel="stylesheet" />
    <style type="text/css">
        .font-weight-normal
        {
            font-weight: normal;
        }
        .img img {
            max-height: 60px;
            max-width: 60px;
        }
        .table.prdlstouter {
            margin-top: 20px;
        }
        .ui-menu img{
            width:40px;
            height:40px;
        }
        .ui-menu li span{
            font-size:1em;
            padding:0 0 10px 10px;
            margin:0 0 10px 0 !important;
            white-space:nowrap;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 top-margin" id="divspecification">
        <div class="orderWrappernew">
            <div class="innerhead">
                <div class="col-md-1">
                    <a data-toggle="collapse" href="#collapse3" aria-expanded="true"><span class="glyphicon glyphicon-minus"></span></a>
                </div>
                <div class="col-md-11">
                    <h2>Link Size(s) with Package | Supply Products</h2>
                </div>
            </div>
            
            <div class="col-md-12 panel-collapse collapse in" id="collapse3" aria-expanded="true">
                <form action="/linkpackage2prd/save" method="post" id="saveForm">
                    <div class="form row-fluid">
                        <div class="form-group">
                            <div class="col-sm-3">
                                Template:
                                <select name="drpTemplate" id="drpTemplate" class="form-control" onchange="onSelectionChange()">
                                    @foreach (var temp in templates)
                                    {
                                        if (temp.Id == selectedTemplateId)
                                        {
                                            <option value="@temp.Id" selected="selected">@temp.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@temp.Id">@temp.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3">
                                Size:
                                <select name="drpSize" id="drpSize" class="form-control" onchange="onSelectionChange()">
                                    @foreach (var sz in sizes)
                                    {
                                        if (sz.Id == selectedSizeId)
                                        {
                                            <option value="@sz.Id" selected="selected">@sz.Title</option>
                                        }
                                        else
                                        {
                                            <option value="@sz.Id">@sz.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3">
                                Package | Supply:
                                <input type="text" id="txtSearchPackage" class="form-control input-sm" placeholder="Search Package" required="required" />
                                <input type="hidden" name="hfPackageID" id="hfPackageID" />
                            </div>
                            <div class="col-sm-3">
                                Package | Supply Qty / Order:
                                <input type="number" name="txtQty" id="txtQty" class="form-control" value="1" min="1" required="required" />
                            </div>
                        </div>
                        
                        <div class="clearfix"></div>
                        
                        <div class="form-group col-md-12 top-margin">
                            <button type="submit" class="btn btn-sm btn-primary">Submit</button>
                        </div>
                    </div>
                </form>
                
                <div class="clearfix"></div>
                
                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div class="alert alert-success" style="margin: 10px;">@successMsg</div>
                }
                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-danger" style="margin: 10px;">@errorMsg</div>
                }
                
                <div class="clearfix"></div>
                
                @if (linkedItems.Count > 0)
                {
                    <div class="form-group col-md-12 top-margin">
                        <div class="table prdlstouter" id="our_products">
                            <table class="table table-bordred table-striped">
                                <thead>
                                    <tr>
                                        <th>Template</th>
                                        <th>Size</th>
                                        <th>Product</th>
                                        <th>Type</th>
                                        <th>Qty / Order</th>
                                        <th>Modified</th>
                                        <th>Count</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in linkedItems)
                                    {
                                        <tr class="rowtext">
                                            <td>@item.TemplateName</td>
                                            <td>@item.SizeTitle</td>
                                            <td>@item.ProductName</td>
                                            <td>@(item.ProductType == 7 ? "Package" : "Supply")</td>
                                            <td>@item.Qty</td>
                                            <td>@item.ModifiedOn.ToString("dd/MM/yy")</td>
                                            <td>@item.PrdCount</td>
                                            <td>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                                        Manage <span class="caret"></span>
                                                    </button>
                                                    <ul class="dropdown-menu" role="menu">
                                                        <li>
                                                            <form action="/linkpackage2prd/action" method="post" onsubmit="return confirm('Are you sure to update this linking?');">
                                                                <input type="hidden" name="linkId" value="@item.Id" />
                                                                <input type="hidden" name="commandName" value="updatePrd" />
                                                                <button type="submit" class="btn btn-link btn-xs" style="padding: 3px 20px; color:#333; text-align:left; width:100%;">Update Linking</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form action="/linkpackage2prd/action" method="post" onsubmit="return confirm('Are you sure to remove this linking?');">
                                                                <input type="hidden" name="linkId" value="@item.Id" />
                                                                <input type="hidden" name="commandName" value="removePrd" />
                                                                <button type="submit" class="btn btn-link btn-xs" style="padding: 3px 20px; color:#333; text-align:left; width:100%;">Remove Linking</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
<script type="text/javascript">
    function onSelectionChange() {
        var templateId = $("#drpTemplate").val();
        var sizeId = $("#drpSize").val();
        window.location.href = "/linkpackage2prd?templateId=" + templateId + "&sizeId=" + sizeId;
    }

    $(function () {
        $('#txtSearchPackage').autocomplete({
            minLength: 1,
            select: function (event, ui) {
                event.preventDefault();
                $("#txtSearchPackage").val(ui.item.label);
                $("#hfPackageID").val(ui.item.value);
                return false;
            },
            open: function () {
                $(".ui-autocomplete").css("z-index", 1000);
            },
            source: function (request, response) {
                $.ajax({
                    url: "/linkpackage2prd/GetPackageSupplyList",
                    type: "POST",
                    dataType: "json",
                    data: JSON.stringify({ keyword: request.term }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        response($.map(data.d, function (item) {
                            return {
                                label: item.product_name,
                                value: item.product_id,
                                img: item.product_image1 ? "https://cakerstreet1.s3.amazonaws.com/Product_images/resized_80_80/" + item.product_image1 : ""
                            };
                        }))
                    },
                    error: function (xhr, status, error) {
                        console.error("Autocomplete error:", error);
                    }
                });
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            var imgHtml = item.img ? "<img src='" + item.img + "'>" : "";
            return $("<li><div>" + imgHtml + "<span>" + item.label + "</span></div></li>").appendTo(ul);
        };
    });
</script>
