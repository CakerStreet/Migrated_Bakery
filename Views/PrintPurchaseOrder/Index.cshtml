@model PrintPurchaseOrderModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Purchase Order - @Model.InvoiceNo</title>
    <link rel="stylesheet" href="/Admin_Content/css/bootstrap.css" />
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; font-size: 12px; }
        .header-table td { padding: 5px; }
        .items-table th, .items-table td { padding: 4px 8px; font-size: 11px; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 landscape; margin: 5mm; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom:15px;">
        <button onclick="window.print()" class="btn btn-default">Print</button>
    </div>

    <div class="row">
        <div class="col-xs-6">
            <a href="@ViewBag.WebsiteUrl">@ViewBag.WebsiteName</a>
        </div>
        <div class="col-xs-6 text-right">
            <h4>Purchase Order</h4>
        </div>
    </div>
    <hr />

    <table class="table table-bordered header-table">
        <tr>
            <td><strong>PO Number:</strong></td>
            <td>@Model.InvoiceNo</td>
            <td><strong>Purchase Date:</strong></td>
            <td>@Model.PurchaseDate</td>
        </tr>
        <tr>
            <td><strong>Supplier:</strong></td>
            <td>@Model.SupplierName</td>
            <td><strong>Status:</strong></td>
            <td>@Model.StatusText</td>
        </tr>
        <tr>
            <td><strong>Address:</strong></td>
            <td>@Html.Raw(Model.AddressDetail)</td>
            <td><strong>Remarks:</strong></td>
            <td>@Html.Raw(Model.Remarks)</td>
        </tr>
        <tr>
            <td><strong>Supplies Topper:</strong></td>
            <td>@Model.SuppliesTopper</td>
            <td><strong>Supplies Accessories:</strong></td>
            <td>@Model.SuppliesAccessories</td>
        </tr>
    </table>

    @if (Model.Items.Any())
    {
        <table class="table table-striped table-bordered items-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Batch ID</th>
                    <th>Location</th>
                    <th>Product Code</th>
                    <th>Product Name</th>
                    <th>Qty</th>
                    <th>Rate</th>
                    <th>Amount</th>
                    <th>Disc</th>
                    <th>Subtotal</th>
                    <th>VAT %</th>
                    <th>VAT</th>
                    <th>Net Total</th>
                </tr>
            </thead>
            <tbody>
                @{ var idx = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@idx</td>
                        <td>@item.BatchId</td>
                        <td>@item.Location</td>
                        <td>@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>@item.Qty</td>
                        <td>@item.RatePerItem.ToString("0.00")</td>
                        <td>@item.Amount.ToString("0.00")</td>
                        <td>@item.Discount.ToString("0.00")</td>
                        <td>@item.Subtotal.ToString("0.00")</td>
                        <td>@item.VatPercent.ToString("0.00")</td>
                        <td>@item.Vat.ToString("0.00")</td>
                        <td><strong>@item.NetTotal.ToString("0.00")</strong></td>
                    </tr>
                    idx++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="12" class="text-right"><strong>Grand Total:</strong></td>
                    <td><strong>@Model.Items.Sum(i => i.NetTotal).ToString("0.00")</strong></td>
                </tr>
            </tfoot>
        </table>
    }
    else
    {
        <p>No line items found for this purchase order.</p>
    }
</body>
</html>
