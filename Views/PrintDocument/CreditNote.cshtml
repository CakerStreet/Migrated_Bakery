@model CakerStreet.Business.Services.CreditNotePrintResult
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Refund / Credit Note</title>
    <style type="text/css" media="print">
        #dvPrintButtons {
            visibility: hidden;
            display: none;
        }
        @@media page {
            size: A4 landscape;
        }
    </style>
    <style type="text/css">
        body {
            font-family: Arial, sans-serif;
            color: #555;
            font-size: 12px;
        }
        .container {
            width: 100%;
            margin: 0 auto;
            padding: 10px;
        }
        .text-right {
            text-align: right;
        }
        .panel {
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-bottom: 15px;
        }
        .panel-heading {
            background-color: #f5f5f5;
            padding: 8px 15px;
            border-bottom: 1px solid #ddd;
            font-weight: bold;
        }
        .panel-body {
            padding: 15px;
        }
        .panel-info {
            border-color: #bce8f1;
        }
        .panel-info > .panel-heading {
            background-color: #d9edf7;
            border-color: #bce8f1;
            color: #31708f;
        }
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .table th, .table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        .table th {
            background-color: #f5f5f5;
        }
        .row {
            display: flex;
            margin-left: -15px;
            margin-right: -15px;
        }
        .col-xs-6 {
            width: 50%;
            padding: 0 15px;
        }
        .col-xs-5 {
            width: 41.666%;
            padding: 0 15px;
        }
        .col-xs-7 {
            width: 58.333%;
            padding: 0 15px;
        }
        .col-xs-offset-2 {
            margin-left: 16.666%;
        }
        .btn {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 6px 12px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div id="dvPrintButtons" style="margin-top: 5px; text-align: center; margin-bottom: 15px;">
            <input id="btnPrint" class="btn" onclick="window.print();" type="button" value="Print" />
        </div>
        <div class="row" style="margin-bottom: 20px;">
            <div class="col-xs-6">
                <h1>
                    <img src="~/img/logo.jpg" alt="Logo" onerror="this.style.display='none';" />
                    <span style="font-size: 28px; font-weight: bold; color: #DB080C; vertical-align: middle;">CakerStreet</span>
                </h1>
            </div>
            <div class="col-xs-6 text-right">
                <h1 style="margin: 0; font-size: 24px;">Refund / Credit Note</h1>
                <h2 style="margin: 5px 0; font-size: 16px; color: #777;">
                    Credit Note #@Model.CreditNoteNo
                </h2>
                <h2 style="margin: 5px 0; font-size: 14px; color: #777;">
                    Refund on order #@Model.OrderId
                </h2>
                <h2 style="margin: 5px 0; font-size: 14px; color: #777;">
                    Issue Date: @Model.CreditDate.ToString("dd-MMM-yyyy")
                </h2>
                <h2 style="margin: 5px 0; font-size: 14px; color: #777;">
                    Refund Generated By: @Model.CreditGeneratedBy
                </h2>
            </div>
        </div>

        <div class="row" style="margin-bottom: 20px;">
            <div class="col-xs-5">
                <div class="panel">
                    <div class="panel-heading">
                        Customer Detail: @Model.CustomerName
                    </div>
                    <div class="panel-body">
                        <p>
                            @Model.BillingAddress<br />
                            @Model.BillingCity<br />
                            @Model.BillingCounty<br />
                            @Model.BillingZip<br />
                            @Model.BillingCountry<br />
                            Phone: @Model.BillingPhone<br />
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-xs-5 col-xs-offset-2">
                <div class="panel">
                    <div class="panel-heading">
                        From: CakerStreet
                    </div>
                    <div class="panel-body">
                        <p>
                            Unit 5, Safestore<br />
                            Staples Corner Business Park, 1000 North Circular Road<br />
                            London, NW2 7JP<br />
                            United Kingdom<br />
                            Company No: 09272304<br />
                            Vat Number: GB203492721<br />
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Item</th>
                    <th class="text-right">Price</th>
                    <th class="text-right">Qty</th>
                    <th class="text-right">Sub Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.LineItems)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>
                            @item.ProductName
                            @if (!string.IsNullOrEmpty(item.ShapeTitle))
                            {
                                <br /><b>Shape:</b> @item.ShapeTitle
                            }
                            @if (!string.IsNullOrEmpty(item.TypeTitle))
                            {
                                <br /><b>Type:</b> @item.TypeTitle
                            }
                            @if (!string.IsNullOrEmpty(item.SizeTitle))
                            {
                                <br /><b>Size:</b> @item.SizeTitle
                            }
                            @if (!string.IsNullOrEmpty(item.ShapeText))
                            {
                                <br /><b>Text:</b> @item.ShapeText
                            }
                            @if (!string.IsNullOrEmpty(item.RefundRemarks))
                            {
                                <br /><span style="color:#DB080C;"><b>Reason:</b> @item.RefundRemarks</span>
                            }
                        </td>
                        <td class="text-right">&pound;@item.UnitPrice.ToString("F2")</td>
                        <td class="text-right">@item.QtyReturned</td>
                        <td class="text-right">&pound;@item.RefundAmount.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row text-right" style="margin-top: 20px; font-size: 16px;">
            <div style="flex-grow: 1; padding-right: 15px; font-weight: bold;">
                Credit Amount :
            </div>
            <div style="width: 150px; font-weight: bold; color: #DB080C; padding-right: 15px;">
                &pound;@Model.CreditAmount.ToString("F2")
            </div>
        </div>

        <div class="row" style="margin-top: 20px;">
            <div class="col-xs-5">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        Billing Address
                    </div>
                    <div class="panel-body">
                        <p>
                            @Model.BillingFName @Model.BillingLName<br />
                            @Model.BillingAddress<br />
                            @Model.BillingCity<br />
                            @Model.BillingCounty<br />
                            @Model.BillingZip<br />
                            @Model.BillingCountry
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-xs-7">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        Contact Details
                    </div>
                    <div class="panel-body">
                        <p>
                            Email: @Model.CustomerEmail<br /><br />
                            Phone: @Model.BillingPhone
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
