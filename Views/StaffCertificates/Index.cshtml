@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var staffList = ViewBag.StaffList as List<CakerStreet.Business.Services.BakeryStaffItem> ?? new();
    var groupedList = ViewBag.GroupedList as List<CakerStreet.Business.Services.StaffCertificatesGroup> ?? new();
    var uploadList = ViewBag.UploadList as List<CakerStreet.Business.Services.StaffCertificateItem> ?? new();
    var selectedStaffId = (long)ViewBag.SelectedStaffId;
    var successMsg = ViewBag.SuccessMessage as string;
}

@section Head {
    <style type="text/css">
        .inventoryWrapper .innerhead {
            display: table;
            width: 100%;
        }
        .normallink, .normallink:hover, .normallink:focus {
            font-size: 14px;
            text-decoration: underline;
            color: #fff;
        }
        .headertext {
            display: table;
            margin-bottom: 10px;
            width: 100%;
            background-color: #ddd;
            line-height: 34px;
            padding: 0 10px;
            text-align: right;
        }
        .headertext label {
            float: left;
        }
        .div_QuestionMainList_outer, .div_ResultMain {
            display: table;
            width: 100%;
        }
        .UL_ResultMain {
            display: table-row;
            line-height: 20px;
        }
        .UL_ResultMain.headertext {
            background-color: #ccc;
            font-weight: bold;
        }
        .UL_ResultMain > li {
            display: table-cell;
            padding: 10px 7px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        .UL_ResultMain.headertext > li {
            line-height: 34px;
            padding: 0 7px;
        }
        .padding-top-mobile {
            border-top: 1px solid #ccc;
            padding-top: 20px;
            margin-top: 20px;
        }
        .certificate-item-list {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }
        .certificate-item-list li {
            padding: 4px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .delete-btn {
            background: none;
            border: none;
            color: #d9534f;
            cursor: pointer;
            padding: 0 5px;
            font-weight: bold;
        }
        .delete-btn:hover {
            color: #c9302c;
        }
    </style>
}

<div class="row top-margin-less bakerypagecss">
    <div class="col-md-12">
        <div class="panel panel-default no-out-border">
            <div class="col-lg-12 col-md-12 col-sm-12 top-margin">
                <div class="orderWrappernew">
                    <div class="innerhead">
                        <div class="col-md-12" style="padding-left: 0; padding-right: 0;">
                            <h2>
                                Manage Staff Certificates
                                <a href="/food-standards" class="pull-right normallink">Back</a>
                            </h2>
                        </div>
                    </div>

                    <div class="col-md-12 panel-collapse collapse in" id="collapse4" aria-expanded="true" style="padding-left: 0; padding-right: 0; margin-top: 15px;">
                        
                        @if (!string.IsNullOrEmpty(successMsg))
                        {
                            <div class="alert alert-success">
                                @successMsg
                            </div>
                        }

                        <div class="col-md-12" style="padding-left: 0; padding-right: 0; margin-bottom: 20px;">
                            <label for="ddlStaff" style="font-weight: bold; margin-bottom: 5px;">Select Staff Member:</label>
                            <select id="ddlStaff" class="form-control" onchange="location.href='/managestaffcerificates?staffId=' + this.value;">
                                <option value="0">--Select Staff--</option>
                                @foreach (var staff in staffList)
                                {
                                    var isSelected = selectedStaffId == staff.Id ? "selected" : "";
                                    <option value="@staff.Id" @isSelected>@staff.Name</option>
                                }
                            </select>
                        </div>

                        <div class="clearfix"></div>

                        @if (selectedStaffId > 0)
                        {
                            <div id="dvCleaningChecklist_outer">
                                <form action="/managestaffcerificates/submit" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="staffId" value="@selectedStaffId" />

                                    <div id="dvCleaningChecklist" class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr class="active">
                                                    <th style="width: 50%;">Certificate Name</th>
                                                    <th style="width: 50%;">Document / File</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < uploadList.Count; i++)
                                                {
                                                    var item = uploadList[i];
                                                    <tr>
                                                        <td>
                                                            <input type="hidden" name="ids" value="@item.Id" />
                                                            <input type="text" name="titles" value="@item.Name" placeholder="Certificate Title" class="form-control input-sm" />
                                                        </td>
                                                        <td>
                                                            <input type="hidden" name="oldFiles" value="@item.Filename" />
                                                            <input type="file" name="file_@i" class="form-control input-sm" style="display: inline-block; width: auto; max-width: 250px;" />
                                                            @if (!string.IsNullOrEmpty(item.Filename))
                                                            {
                                                                <a href="/upload/staffcertificates/@item.Filename" target="_blank" class="btn btn-default btn-xs" style="margin-left: 10px;">
                                                                    View Uploaded File
                                                                </a>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="form-group" style="margin-top: 15px;">
                                        <button type="submit" class="btn btn-black square">Submit</button>
                                        <a href="/managestaffcerificates" class="btn btn-default">Cancel</a>
                                    </div>
                                </form>
                            </div>
                        }

                        <div class="clearfix"></div>

                        @if (groupedList.Count > 0)
                        {
                            <div class="col-lg-12 padding-top-mobile" id="frmGridDataOuter">
                                <div class="col-md-12 col-xs-12 text-left no-left-padding no-right-padding">
                                    <div class="div_QuestionMainList_outer">
                                        <div class="div_ResultMain">
                                            <ul class="UL_ResultMain headertext">
                                                <li style="width: 40%;">Staff Member</li>
                                                <li style="width: 60%;">Uploaded Certificates</li>
                                            </ul>

                                            @foreach (var group in groupedList)
                                            {
                                                <ul class="UL_ResultMain">
                                                    <td style="vertical-align: top; padding: 10px; border-bottom: 1px solid #ddd;">
                                                        <strong>@group.StaffName</strong>
                                                    </td>
                                                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                                        <ul class="certificate-item-list">
                                                            @foreach (var cert in group.Certificates)
                                                            {
                                                                <li>
                                                                    <a href="/upload/staffcertificates/@cert.File" target="_blank" class="text-info">
                                                                        @cert.Title
                                                                    </a>
                                                                    <form action="/managestaffcerificates/delete/@cert.CertificateId?staffId=@selectedStaffId" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this certificate?');">
                                                                        <button type="submit" class="delete-btn" title="Delete">X</button>
                                                                    </form>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </td>
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
