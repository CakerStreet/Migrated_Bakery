@{
    ViewData["Title"] = "Manage Supervisor";
    var fullName = ViewBag.FullName as string ?? "";
    var email = ViewBag.Email as string ?? "";
    var mobile = ViewBag.Mobile as string ?? "";
}

@section Head {
    <link href="/css/manageinventory.css" rel="stylesheet" />
    <style type="text/css">
        .middleSection { width: 100%; }
        .alert-msg { display: none; margin: 10px 0; }
    </style>
}

<div class="row top-margin"></div>
<div class="clearfix"></div>

<div class="inventoryWrapper">
    <div class="innerhead">
        <h2 style="display: inline-block;">Manage Supervisor</h2>
    </div>
    <div class="col-lg-12 padding-top-mobile">
        <div id="divMessage" class="alert alert-msg"></div>
        <div class="clearfix"></div>
        <div class="col-md-8 col-xs-12 text-left no-left-padding no-right-padding">
            <div class="row-fluid category_box">
                <div class="clearfix"></div>
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" class="form-control" id="txtFullName" value="@fullName" placeholder="Enter full name" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="text" class="form-control" id="txtEmail" value="@email" placeholder="Enter email" />
                </div>
                <div class="form-group">
                    <label>Mobile</label>
                    <input type="text" class="form-control" id="txtMobile" value="@mobile" placeholder="Enter mobile number" />
                </div>
                <div class="divbtnmain_outer">
                    <a href="javascript:void(0);" class="btn btn-lg btn-black square" onclick="saveSupervisor();">Save</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section FooterScripts {
<script type="text/javascript">
    function showMessage(msg, isSuccess) {
        var $div = $('#divMessage');
        $div.removeClass('alert-danger alert-success');
        $div.addClass(isSuccess ? 'alert-success' : 'alert-danger');
        $div.text(msg).fadeIn();
        setTimeout(function () { $div.fadeOut(); }, 4000);
    }

    function saveSupervisor() {
        var fullName = $('#txtFullName').val().trim();
        var email = $('#txtEmail').val().trim();
        var mobile = $('#txtMobile').val().trim();

        if (!fullName) {
            showMessage('Please enter full name.', false);
            return;
        }

        var formData = new FormData();
        formData.append('fullName', fullName);
        formData.append('email', email);
        formData.append('mobile', mobile);

        $.ajax({
            url: '/managesbakeryuperviser/save',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (r) {
                if (r.success) {
                    showMessage(r.message, true);
                } else {
                    showMessage(r.message || 'Failed to save.', false);
                }
            },
            error: function () {
                showMessage('An error occurred while saving.', false);
            }
        });
    }
</script>
}
