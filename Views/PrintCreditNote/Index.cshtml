@*
    Print view for Refund / Credit Note.
    Migrated from: printcreditnote.aspx
    Layout: _PrintLayout (standalone print page, no sidebar)
*@
@{
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    ViewBag.Title = "Refund / Credit Note";

    var orderInfo = ViewBag.OrderInfo as List<Dictionary<string, object>>;
    var items = ViewBag.Items as List<Dictionary<string, object>>;
}

<style type="text/css" media="print">
    @@import url(https://fonts.googleapis.com/css?family=Bree+Serif);
    body, h1, h2, h3, h4, h5, h6 {
        font-family: 'Bree Serif', serif;
    }
    #dvPrintButtons {
        visibility: hidden;
        display: none;
    }
    @@media page {
        size: A4 landscape;
    }
    #dvTotal { page-break-after: always; }
</style>

<div class="container">
    @* ── Print / Back buttons (hidden on print) ── *@
    <div id="dvPrintButtons" class="row hidden-print" style="margin-top: 5px; text-align: center;">
        <div class="btn-group">
            <button type="button" class="btn btn-primary btn-sm" onclick="window.print();">Print</button>
        </div>
    </div>

    @* ── Header: Logo + Credit Note info ── *@
    <div class="row">
        <div class="col-xs-6">
            <h1><img src="../img/logo.jpg" /></h1>
        </div>
        <div class="col-xs-6 text-right">
            <h1>Refund / Credit Note</h1>
            <h2><small>Credit Note #@ViewBag.InvoiceNo</small></h2>
            <h2><small>Refund on order #@ViewBag.OrderNo</small></h2>
            <h2><small>Issue Date: @ViewBag.InvoiceDate</small></h2>
            <h2><small>Refund Generated By: @ViewBag.PaymentMode</small></h2>
        </div>
    </div>

    @* ── Customer Detail / Company From panels ── *@
    @if (orderInfo != null)
    {
        foreach (var info in orderInfo)
        {
            <div class="row">
                <div class="col-xs-5">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4>Customer Detail: <a>@info["order_customerName"]</a></h4>
                        </div>
                        <div class="panel-body">
                            <p>
                                @info["billing_address"]<br />
                                @info["billing_city"]<br />
                                @info["billing_county"]<br />
                                @info["billing_zip"]<br />
                                @info["billing_country"]<br />
                                Phone: @info["billing_phone"]<br />
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xs-5 col-xs-offset-2">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4>From : <a>@ViewBag.CompanyName</a></h4>
                        </div>
                        <div class="panel-body">
                            <p>
                                @Html.Raw(ViewBag.CompanyAddress)<br />
                                Company No: @ViewBag.CompanyNo<br />
                                Vat Number: @ViewBag.VatNumber<br />
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @* ── Line items table ── *@
    @if (items != null && items.Count > 0)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th><h4>SKU</h4></th>
                    <th><h4>Item</h4></th>
                    <th><h4>Price</h4></th>
                    <th><h4>Qty</h4></th>
                    <th><h4>Sub Total</h4></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item["product_code"]</td>
                        <td>
                            @item["product_Name"]
                            @Html.Raw(item["VariantHtml"])
                        </td>
                        <td class="text-right">&pound;@item["UnitPrice"]</td>
                        <td class="text-right">@item["qty_returned"]</td>
                        <td class="text-right">&pound;@item["SubTotal"]</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ── Total credit amount ── *@
    <div id="dvTotal" class="row text-right">
        <div class="col-md-2 col-md-offset-8 col-xs-3 col-xs-offset-7">
            <p><strong>Credit Amount :</strong></p>
        </div>
        <div class="col-md-2 col-xs-2">
            <strong>&pound;@ViewBag.TotalCreditAmount</strong>
        </div>
    </div>

    @* ── Billing address & contact details ── *@
    @if (orderInfo != null)
    {
        foreach (var info in orderInfo)
        {
            <div class="row">
                <div class="col-xs-5">
                    <div class="panel panel-info">
                        <div class="panel-heading"><h4>Billing Address</h4></div>
                        <div class="panel-body">
                            <p>
                                @info["billing_fName"] @info["billing_lName"]<br />
                                @info["billing_address"]<br />
                                @info["billing_city"]<br />
                                @info["billing_county"]<br />
                                @info["billing_zip"]<br />
                                @info["billing_country"]
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xs-7">
                    <div class="span7">
                        <div class="panel panel-info">
                            <div class="panel-heading"><h4>Contact Details</h4></div>
                            <div class="panel-body">
                                <p>
                                    Email : @info["order_customerEmail"]<br /><br />
                                    Phone : @info["billing_phone"]<br /><br />
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
