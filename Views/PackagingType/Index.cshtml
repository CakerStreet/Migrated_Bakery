@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var list = ViewBag.List as List<CakerStreet.Business.Services.PackagingTypeItem> ?? new();
    var prdTypeFilter = (int)ViewBag.ProductTypeFilter;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var successMsg = ViewBag.SuccessMessage as string;
    var errorMsg = ViewBag.ErrorMessage as string;
    var editItem = ViewBag.EditItem as CakerStreet.Business.Services.PackagingTypeItem;
    var showModal = editItem != null || Context.Request.Query.ContainsKey("add");
}

@section Head {
    <style type="text/css">
        .inventoryWrapper .innerhead {
            display: table;
            width: 100%;
        }
        .normallink, .normallink:hover, .normallink:focus {
            font-size: 14px;
            text-decoration: underline;
            color: #fff;
        }
        .action-bar {
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .modal-backdrop-custom {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1040;
        }
        .modal-custom {
            display: block;
            z-index: 1050;
            position: fixed;
            top: 10%;
            left: 50%;
            transform: translate(-50%, 0);
            width: 90%;
            max-width: 600px;
            background: #fff;
            border-radius: 6px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        }
        .modal-header-custom {
            padding: 15px;
            border-bottom: 1px solid #e5e5e5;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-body-custom {
            padding: 15px;
        }
        .modal-title-custom {
            margin: 0;
            font-size: 18px;
            font-weight: bold;
        }
    </style>
}

<div class="row top-margin-less bakerypagecss">
    <div class="col-md-12">
        <div class="panel panel-default no-out-border">
            <div class="col-lg-12 col-md-12 col-sm-12 top-margin">
                <div class="orderWrappernew">
                    <div class="innerhead">
                        <div class="col-md-12" style="padding-left: 0; padding-right: 0;">
                            <h2>
                                Manage Packaging Types
                                <a href="/food-standards" class="pull-right normallink">Back</a>
                            </h2>
                        </div>
                    </div>

                    <div class="col-md-12 panel-collapse collapse in" id="collapse4" aria-expanded="true" style="padding-left: 0; padding-right: 0; margin-top: 15px;">
                        
                        @if (!string.IsNullOrEmpty(successMsg))
                        {
                            <div class="alert alert-success">
                                @successMsg
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger">
                                @errorMsg
                            </div>
                        }

                        <form id="bulkForm" action="/managepackagingtype/bulk" method="post">
                            <input type="hidden" name="bulkAction" id="bulkActionInput" value="" />

                            <div class="action-bar">
                                <div class="btn-group">
                                    <button class="btn btn-danger bg-red dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Action on <span id="spnfilterselected">0</span> selected <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a href="#" onclick="submitBulk('active');">Set as Active</a></li>
                                        <li><a href="#" onclick="submitBulk('inactive');">Set as Inactive</a></li>
                                        <li><a href="#" onclick="submitBulk('update');">Update Display Orders</a></li>
                                        <li><a href="#" onclick="submitBulk('delete');">Remove</a></li>
                                    </ul>
                                </div>

                                <div class="search-filters">
                                    <select id="ddlPrdType" class="form-control input-sm" style="max-width:200px; display:inline-block; vertical-align: middle;" onchange="applyFilters();">
                                        <option value="0" selected="@(prdTypeFilter == 0)">--Select Product Type--</option>
                                        <option value="4" selected="@(prdTypeFilter == 4)">Cake Toppers</option>
                                        <option value="5" selected="@(prdTypeFilter == 5)">Cutters / Moulds</option>
                                        <option value="7" selected="@(prdTypeFilter == 7)">Packaging</option>
                                        <option value="8" selected="@(prdTypeFilter == 8)">Supplies</option>
                                        <option value="9" selected="@(prdTypeFilter == 9)">Appliances</option>
                                        <option value="10" selected="@(prdTypeFilter == 10)">Shop Setup</option>
                                    </select>
                                    <input type="text" id="txtsearch" value="@searchTerm" placeholder="Search keyword" class="form-control input-sm" style="max-width:200px; display:inline-block; vertical-align: middle;" />
                                    <button type="button" class="btn btn-danger btn-sm" onclick="applyFilters();">Go</button>
                                    <a href="/managepackagingtype" class="btn btn-default btn-sm">X</a>
                                </div>

                                <div>
                                    <a href="/managepackagingtype?add=1" class="btn btn-success btn-sm">
                                        <span class="glyphicon glyphicon-plus"></span> Add New
                                    </a>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-striped">
                                    <thead>
                                        <tr class="active">
                                            <th style="width: 5%; text-align: center;">
                                                <input type="checkbox" id="chkAll" onchange="toggleSelectAll(this);" />
                                            </th>
                                            <th style="width: 35%;">Packaging Type</th>
                                            <th style="width: 15%;">Product Count</th>
                                            <th style="width: 15%;">Type</th>
                                            <th style="width: 10%;">Status</th>
                                            <th style="width: 10%;">Display Order</th>
                                            <th style="width: 10%;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (list.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center" style="padding: 20px;">No records found.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            foreach (var item in list)
                                            {
                                                <tr>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <input type="checkbox" name="checkedRows" value="@item.PackagingTypeId" class="chk-row" onchange="updateSelectedCount();" />
                                                    </td>
                                                    <td style="vertical-align: middle;">@item.PackagingType</td>
                                                    <td style="vertical-align: middle;">@item.PrdCount</td>
                                                    <td style="vertical-align: middle;">@item.ProductType</td>
                                                    <td style="vertical-align: middle;">
                                                        <span class="label @(item.IsActive ? "label-success" : "label-danger")">
                                                            @(item.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" name="displayOrder_@item.PackagingTypeId" value="@item.DisplayOrder" class="form-control input-sm" style="width: 60px; text-align: center;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <a href="/managepackagingtype?editId=@item.PackagingTypeId" class="text-danger" style="font-weight: bold;">Edit</a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    var valEditId = editItem?.PackagingTypeId ?? 0;
    var valTitle = editItem?.PackagingType ?? "";
    var valProductType = editItem?.PrdType ?? prdTypeFilter;
    var isEdit = editItem != null;

    <div class="modal-backdrop-custom"></div>
    <div class="modal-custom">
        <div class="modal-header-custom">
            <h4 class="modal-title-custom">@(isEdit ? "Edit" : "Add New") Packaging Type</h4>
            <a href="/managepackagingtype" class="close" style="font-size: 24px; text-decoration: none;">&times;</a>
        </div>
        <div class="modal-body-custom">
            <form action="/managepackagingtype/save" method="post" class="form-horizontal">
                <input type="hidden" name="editId" value="@valEditId" />

                <div class="form-group">
                    <label class="col-sm-3 control-label">Packaging Type: <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" name="title" value="@valTitle" class="form-control" required />
                    </div>
                </div>

                <div class="form-group" style="margin-top: 15px;">
                    <label class="col-sm-3 control-label">Product Type: <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <select name="productType" class="form-control" required>
                            <option value="0">--Select Product Type--</option>
                            <option value="4" selected="@(valProductType == 4)">Cake Toppers</option>
                            <option value="5" selected="@(valProductType == 5)">Cutters / Moulds</option>
                            <option value="7" selected="@(valProductType == 7)">Packaging</option>
                            <option value="8" selected="@(valProductType == 8)">Supplies</option>
                            <option value="9" selected="@(valProductType == 9)">Appliances</option>
                            <option value="10" selected="@(valProductType == 10)">Shop Setup</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <div class="col-sm-offset-3 col-sm-9">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a href="/managepackagingtype" class="btn btn-danger" style="margin-left: 10px;">Close</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<script type="text/javascript">
    function toggleSelectAll(master) {
        var checkboxes = document.getElementsByClassName('chk-row');
        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].checked = master.checked;
        }
        updateSelectedCount();
    }

    function updateSelectedCount() {
        var checkboxes = document.getElementsByClassName('chk-row');
        var count = 0;
        for (var i = 0; i < checkboxes.length; i++) {
            if (checkboxes[i].checked) {
                count++;
            }
        }
        document.getElementById('spnfilterselected').innerText = count;
    }

    function submitBulk(action) {
        var count = parseInt(document.getElementById('spnfilterselected').innerText);
        if (count === 0) {
            alert('Please select at least one item.');
            return;
        }

        if (action === 'delete') {
            if (!confirm('Are you sure you want to remove selected ' + count + ' item(s)? Note: Only items with no products assigned will be deleted.')) {
                return;
            }
        }

        document.getElementById('bulkActionInput').value = action;
        document.getElementById('bulkForm').submit();
    }

    function applyFilters() {
        var typeId = document.getElementById('ddlPrdType').value;
        var search = document.getElementById('txtsearch').value.trim();
        var url = '/managepackagingtype?typeid=' + typeId;
        if (search) {
            url += '&search=' + encodeURIComponent(search);
        }
        location.href = url;
    }
</script>
